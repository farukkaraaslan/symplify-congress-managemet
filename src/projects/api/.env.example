# ============================================================
# Symplify Public API - Production Environment Example
# Copy this file as .env on the production server.
# DO NOT commit the real .env file.
# ============================================================

ASPNETCORE_ENVIRONMENT=Production

# Database
API_DB_CONNECTION_STRING=Host=postgres;Port=5432;Database=Symplify;Username=CHANGE_ME;Password=CHANGE_ME

# Object Storage / MinIO
API_OBJECT_STORAGE_PROVIDER=Minio
API_OBJECT_STORAGE_ENDPOINT=minio:9000
API_OBJECT_STORAGE_USE_SSL=false
API_OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
API_OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
API_OBJECT_STORAGE_REGION=us-east-1

API_OBJECT_STORAGE_BUCKET_CONGRESS_DOCUMENTS=symplify-congress-documents
API_OBJECT_STORAGE_BUCKET_CONGRESS_IMAGES=symplify-congress-images
API_OBJECT_STORAGE_BUCKET_SUBMISSIONS=symplify-submissions

# Public Assets
API_PUBLIC_ASSETS_BASE_URL=https://CHANGE_ME
API_PUBLIC_ASSETS_RELATIVE_PATH_PREFIX=
API_PUBLIC_ASSETS_STATIC_FILES_BASE_URL=https://CHANGE_ME
API_PUBLIC_ASSETS_OBJECT_STORAGE_BASE_URL=https://CHANGE_ME/public-assets
API_PUBLIC_ASSETS_IMAGES_OBJECT_STORAGE_BASE_URL=https://CHANGE_ME/public-assets
API_PUBLIC_ASSETS_DOCUMENTS_OBJECT_STORAGE_BASE_URL=https://CHANGE_ME/public-assets
API_PUBLIC_ASSETS_PREFER_DIRECT_OBJECT_STORAGE=true
