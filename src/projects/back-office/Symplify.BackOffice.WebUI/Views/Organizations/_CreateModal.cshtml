@model Symplify.BackOffice.WebUI.Models.Organizations.CreateOrganizationViewModel
@inject Symplify.BackOffice.WebUI.Localization.IBackOfficeViewLocalizer L

<div class="modal fade" id="createOrganizationModal" tabindex="-1" aria-labelledby="createOrganizationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="createOrganizationForm" method="post" enctype="multipart/form-data" autocomplete="off">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="createOrganizationModalLabel">@L["BackOffice.Organizations.CreateTitle"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L.GetStringValue("Common.Close")"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label">@L["BackOffice.Organizations.Fields.Name"]</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Code" class="form-label">@L["BackOffice.Organizations.Fields.Code"]</label>
                            <input asp-for="Code" class="form-control" placeholder="@L.GetStringValue("BackOffice.Organizations.Placeholders.Code")" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="ShortName" class="form-label">@L["BackOffice.Organizations.Fields.ShortName"]</label>
                            <input asp-for="ShortName" class="form-control" />
                            <span asp-validation-for="ShortName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="WebsiteUrl" class="form-label">@L["BackOffice.Organizations.Fields.WebsiteUrl"]</label>
                            <input asp-for="WebsiteUrl" class="form-control" placeholder="@L.GetStringValue("BackOffice.Organizations.Placeholders.WebsiteUrl")" />
                            <span asp-validation-for="WebsiteUrl" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="BrandColor" class="form-label">@L["BackOffice.Organizations.Fields.BrandColor"]</label>
                            <input asp-for="BrandColor" class="form-control form-control-color w-100" type="color" />
                            <span asp-validation-for="BrandColor" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="LogoFile" class="form-label">@L["BackOffice.Organizations.Fields.Logo"]</label>
                            <input asp-for="LogoFile" class="form-control" type="file" accept=".png,.jpg,.jpeg,.svg" />
                            <span asp-validation-for="LogoFile" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label">@L["BackOffice.Organizations.Fields.Description"]</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactName" class="form-label">@L["BackOffice.Organizations.Fields.ContactName"]</label>
                            <input asp-for="ContactName" class="form-control" />
                            <span asp-validation-for="ContactName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactTitle" class="form-label">@L["BackOffice.Organizations.Fields.ContactTitle"]</label>
                            <input asp-for="ContactTitle" class="form-control" />
                            <span asp-validation-for="ContactTitle" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactEmail" class="form-label">@L["BackOffice.Organizations.Fields.ContactEmail"]</label>
                            <input asp-for="ContactEmail" class="form-control" />
                            <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ContactPhone" class="form-label">@L["BackOffice.Organizations.Fields.ContactPhone"]</label>
                            <input asp-for="ContactPhone" class="form-control" />
                            <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="ContactNote" class="form-label">@L["BackOffice.Organizations.Fields.ContactNote"]</label>
                            <textarea asp-for="ContactNote" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="ContactNote" class="text-danger small"></span>
                        </div>

                        <div class="col-md-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label asp-for="IsActive" class="form-check-label">@L["Common.Active"]</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">@L["Common.Close"]</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i> @L["BackOffice.Organizations.Buttons.Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
