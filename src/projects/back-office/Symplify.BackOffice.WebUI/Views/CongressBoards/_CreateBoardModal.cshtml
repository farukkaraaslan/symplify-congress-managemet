@model Symplify.BackOffice.WebUI.Models.CongressBoards.CreateCongressBoardManageViewModel
@inject Symplify.BackOffice.WebUI.Localization.IBackOfficeViewLocalizer L

@{
    string currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    string postUrl = Url.Action("CreateManage", "CongressBoards", new { culture = currentCulture }) ?? $"/{currentCulture}/congress-boards/create-manage";
    string defaultLanguageLabel = L.GetStringValue("Common.Default");
    if (string.IsNullOrWhiteSpace(defaultLanguageLabel) || string.Equals(defaultLanguageLabel, "Common.Default", StringComparison.OrdinalIgnoreCase))
    {
        defaultLanguageLabel = "Varsayılan";
    }
}

<div class="modal fade" id="createCongressBoardModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="createCongressBoardForm" action="@postUrl" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CongressId" />

                <div class="modal-header">
                    <div>
                        <h6 class="modal-title">@L.GetStringValue("BackOffice.CongressBoards.Create.Title")</h6>
                        <small class="text-neutral-500 d-block mt-1">@L.GetStringValue("BackOffice.CongressBoards.Create.Description")</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@L.GetStringValue("Common.Close")'></button>
                </div>

                <div class="modal-body">
                    <div class="card border shadow-none mb-4">
                        <div class="card-header border-bottom"><h6 class="text-md mb-0">@L.GetStringValue("Common.BasicInformation")</h6></div>
                        <div class="card-body">
                            <div class="form-switch switch-primary d-flex align-items-center gap-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label">@L.GetStringValue("Common.ActiveQuestion")</label>
                            </div>
                        </div>
                    </div>

                    <div class="card border shadow-none">
                        <div class="card-header border-bottom"><h6 class="text-md mb-0">@L.GetStringValue("Common.Translations")</h6></div>
                        <div class="card-body">
                            <ul class="nav nav-pills mb-3" role="tablist">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    string paneId = "boardCreateTranslation-" + i;
                                    string tabId = paneId + "-tab";

                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(i == 0 ? "active" : string.Empty)"
                                                id="@tabId"
                                                data-bs-toggle="pill"
                                                data-bs-target="#@paneId"
                                                type="button"
                                                role="tab"
                                                aria-controls="@paneId"
                                                aria-selected="@(i == 0 ? "true" : "false")">
                                            <span class="d-inline-flex align-items-center gap-2">
                                                <span>@Model.Translations[i].LanguageName</span>
                                                @if (Model.Translations[i].IsDefault)
                                                {
                                                    <span class="badge bg-primary-50 text-primary-600 rounded-pill">@defaultLanguageLabel</span>
                                                }
                                            </span>
                                        </button>
                                    </li>
                                }
                            </ul>
                            <div class="tab-content">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    <div class="tab-pane fade @(i == 0 ? "show active" : null)" id="boardCreateTranslation-@i" role="tabpanel" aria-labelledby="boardCreateTranslation-@i-tab" tabindex="0">
                                        <input type="hidden" asp-for="Translations[i].LanguageId" />
                                        <input type="hidden" asp-for="Translations[i].Culture" />
                                        <input type="hidden" asp-for="Translations[i].LanguageName" />
                                        <input type="hidden" asp-for="Translations[i].IsDefault" />
                                        <div class="row gy-4">
                                            <div class="col-12">
                                                <label asp-for="Translations[i].Name" class="form-label">@L.GetStringValue("BackOffice.CongressBoards.Fields.Name") <required-mark visible="@Model.Translations[i].IsDefault"></required-mark></label>
                                                <input asp-for="Translations[i].Name" class="form-control" placeholder='@L.GetStringValue("BackOffice.CongressBoards.Placeholders.Name")' maxlength="200" data-val="@(Model.Translations[i].IsDefault ? "true" : null)" data-val-required="@(Model.Translations[i].IsDefault ? L.GetStringValue("BackOffice.CongressBoards.Validation.DefaultNameRequired") : null)" />
                                                <span asp-validation-for="Translations[i].Name" class="text-danger"></span>
                                            </div>
                                            <div class="col-12">
                                                <label asp-for="Translations[i].Description" class="form-label">@L.GetStringValue("BackOffice.CongressBoards.Fields.Description")</label>
                                                <textarea asp-for="Translations[i].Description" class="form-control" rows="3"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light-100 text-dark radius-8 px-20 py-11 d-flex align-items-center gap-2" data-bs-dismiss="modal">@L.GetStringValue("Common.Cancel")</button>
                    <button type="submit" class="btn btn-primary-600 radius-8 px-20 py-11 d-flex align-items-center gap-2">@L.GetStringValue("BackOffice.CongressBoards.Buttons.Save")</button>
                </div>
            </form>
        </div>
    </div>
</div>

