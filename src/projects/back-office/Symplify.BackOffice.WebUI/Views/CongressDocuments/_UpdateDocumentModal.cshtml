@model Symplify.BackOffice.WebUI.Models.CongressDocuments.UpdateCongressDocumentViewModel
@inject Symplify.BackOffice.WebUI.Localization.IBackOfficeViewLocalizer L

@{
    string currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    string? downloadUrl = Url.Action("Download", "CongressDocuments", new { culture = currentCulture, id = Model.Id, congressId = Model.CongressId });
    string defaultLanguageLabel = L.GetStringValue("Common.Default");
    if (string.IsNullOrWhiteSpace(defaultLanguageLabel) || string.Equals(defaultLanguageLabel, "Common.Default", StringComparison.OrdinalIgnoreCase))
    {
        defaultLanguageLabel = "Varsayılan";
    }
}

<div class="modal fade" id="updateDocumentModal" tabindex="-1" aria-labelledby="updateDocumentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content radius-16">
            <form id="updateCongressDocumentForm"
                  asp-controller="CongressDocuments"
                  asp-action="Update"
                  asp-route-culture="@currentCulture"
                  method="post"
                  enctype="multipart/form-data"
                  autocomplete="off"
                  novalidate>

                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="CongressId" type="hidden" />

                <div class="modal-header border-bottom">
                    <div>
                        <h6 id="updateDocumentModalLabel" class="modal-title mb-0">@L.GetStringValue("BackOffice.CongressDocuments.Update.Title")</h6>
                        <small class="text-neutral-500">@L.GetStringValue("BackOffice.CongressDocuments.Update.Description")</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@L.GetStringValue("Common.Close")'></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-danger d-none js-validation-summary" data-symplify-validation-summary></div>

                    @if (!string.IsNullOrWhiteSpace(Model.OriginalFileName))
                    {
                        <div class="alert alert-info bg-info-50 text-info-700 border-info-100 mb-3 d-flex justify-content-between align-items-center gap-3 flex-wrap">
                            <div>
                                <strong>@Model.OriginalFileName</strong>
                                <div class="text-sm text-neutral-600">@FormatFileSize(Model.FileSize) @(!string.IsNullOrWhiteSpace(Model.ContentType) ? $" · {Model.ContentType}" : string.Empty)</div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(downloadUrl))
                            {
                                <a class="btn btn-info-100 text-info-700 radius-8 px-12 py-8" href="@downloadUrl" target="_blank">
                                    <i class="ri-download-line me-1"></i>
                                    @L.GetStringValue("BackOffice.CongressDocuments.Buttons.Download")
                                </a>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
                    {
                        <div class="alert alert-light border mb-3 d-flex align-items-center justify-content-between gap-3 flex-wrap">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@Model.CoverImageUrl"
                                     alt='@L.GetStringValue("BackOffice.CongressDocuments.Fields.CoverImage")'
                                     class="rounded border object-fit-cover w-72-px h-auto" />
                                <div>
                                    <strong>@L.GetStringValue("BackOffice.CongressDocuments.Fields.CurrentCoverImage")</strong>
                                    <div class="text-sm text-neutral-600">
                                        @Model.CoverImageFileName
                                        @(!string.IsNullOrWhiteSpace(Model.CoverImageContentType) ? $" · {Model.CoverImageContentType}" : string.Empty)
                                        @(Model.CoverImageFileSize.HasValue ? $" · {FormatFileSize(Model.CoverImageFileSize)}" : string.Empty)
                                    </div>
                                </div>
                            </div>
                            <div class="form-check mb-0">
                                <input asp-for="RemoveCoverImage" class="form-check-input" type="checkbox" />
                                <label asp-for="RemoveCoverImage" class="form-check-label text-danger fw-medium">
                                    @L.GetStringValue("BackOffice.CongressDocuments.Fields.RemoveCoverImage")
                                </label>
                            </div>
                        </div>
                    }

                    <div class="row gy-3">
                        <div class="col-md-8">
                            <label asp-for="DocumentTypeId" class="form-label">
                                @L.GetStringValue("BackOffice.CongressDocuments.Fields.DocumentType") <required-mark></required-mark>
                            </label>
                            <select asp-for="DocumentTypeId" class="form-select radius-8" data-val="true" data-val-required='@L.GetStringValue("BackOffice.CongressDocuments.Validation.DocumentTypeRequired")'>
                                <option value="">@L.GetStringValue("Common.Select")</option>
                                @foreach (var item in Model.DocumentTypes)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                            <span asp-validation-for="DocumentTypeId" class="text-danger"></span>
                        </div>

                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-switch switch-primary d-flex align-items-center gap-3 mb-10">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label line-height-1 fw-medium text-secondary-light">
                                    @L.GetStringValue("BackOffice.CongressDocuments.Fields.IsActive")
                                </label>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="card border shadow-none mb-0">
                                <div class="card-header border-bottom py-12">
                                    <h6 class="text-md mb-0">@L.GetStringValue("Common.Translations")</h6>
                                </div>
                                <div class="card-body">
                                    <ul class="nav nav-pills mb-3" role="tablist">
                                        @for (int i = 0; i < Model.Translations.Count; i++)
                                        {
                                            string paneId = $"document-description-lang-{ViewData.ModelMetadata.ModelType.Name}-{i}";
                                            string tabId = paneId + "-tab";

                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link @(i == 0 ? "active" : string.Empty)"
                                                        id="@tabId"
                                                        data-bs-toggle="pill"
                                                        data-bs-target="#@paneId"
                                                        type="button"
                                                        role="tab"
                                                        aria-controls="@paneId"
                                                        aria-selected="@(i == 0 ? "true" : "false")">
                                                    <span class="d-inline-flex align-items-center gap-2">
                                                        <span>@Model.Translations[i].LanguageName</span>
                                                        @if (Model.Translations[i].IsDefault)
                                                        {
                                                            <span class="badge bg-primary-50 text-primary-600 rounded-pill">@defaultLanguageLabel</span>
                                                        }
                                                    </span>
                                                </button>
                                            </li>
                                        }
                                    </ul>

                                    <div class="tab-content">
                                        @for (int i = 0; i < Model.Translations.Count; i++)
                                        {
                                            string paneId = $"document-description-lang-{ViewData.ModelMetadata.ModelType.Name}-{i}";

                                            <div class="tab-pane fade @(i == 0 ? "show active" : string.Empty)" id="@paneId" role="tabpanel" tabindex="0">
                                                <input asp-for="Translations[i].LanguageId" type="hidden" />
                                                <input asp-for="Translations[i].Culture" type="hidden" />
                                                <input asp-for="Translations[i].LanguageName" type="hidden" />
                                                <input asp-for="Translations[i].IsDefault" type="hidden" />
                                                <input asp-for="Translations[i].Exists" type="hidden" />

                                                <label asp-for="Translations[i].Description" class="form-label">
                                                    @L.GetStringValue("BackOffice.CongressDocuments.Fields.Description")
                                                    <span class="text-neutral-500 text-sm">(@L.GetStringValue("BackOffice.CongressDocuments.Label.Optional"))</span>
                                                </label>
                                                <textarea asp-for="Translations[i].Description"
                                                          class="form-control radius-8"
                                                          rows="3"
                                                          maxlength="1000"
                                                          placeholder='@L.GetStringValue("BackOffice.CongressDocuments.Placeholder.Description")'></textarea>
                                                <div class="form-text text-neutral-500">@L.GetStringValue("BackOffice.CongressDocuments.Help.Description")</div>
                                                <span asp-validation-for="Translations[i].Description" class="text-danger"></span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

<div class="col-12">
                            <label asp-for="File" class="form-label">@L.GetStringValue("BackOffice.CongressDocuments.Fields.File")</label>
                            <div class="border radius-12 p-20 bg-neutral-50"
                                 data-symplify-dropzone
                                 data-dropzone-input="#updateCongressDocumentFile"
                                 data-dropzone-accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png,.webp"
                                 data-dropzone-max-size-mb="50"
                                 data-dropzone-selected-text='@L.GetStringValue("BackOffice.CongressDocuments.Dropzone.Selected")'>
                                <input asp-for="File" id="updateCongressDocumentFile" class="form-control d-none" type="file" />
                                <div class="text-center py-24">
                                    <i class="ri-upload-cloud-2-line text-3xl text-primary-600"></i>
                                    <p class="mb-1 fw-medium">@L.GetStringValue("BackOffice.CongressDocuments.Dropzone.Select")</p>
                                    <small class="text-neutral-500">@L.GetStringValue("BackOffice.CongressDocuments.Help.UpdateFile")</small>
                                    <div class="js-dropzone-file-name text-sm text-primary-600 mt-2"></div>
                                </div>
                            </div>
                            <span asp-validation-for="File" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="CoverImage" class="form-label">
                                @L.GetStringValue("BackOffice.CongressDocuments.Fields.CoverImage")
                                <span class="text-neutral-500 text-sm">(@L.GetStringValue("BackOffice.CongressDocuments.Label.Optional"))</span>
                            </label>
                            <div class="border radius-12 p-20 bg-neutral-50"
                                 data-symplify-dropzone
                                 data-dropzone-input="#updateCongressDocumentCoverImage"
                                 data-dropzone-accept=".jpg,.jpeg,.png,.webp"
                                 data-dropzone-max-size-mb="5"
                                 data-dropzone-selected-text='@L.GetStringValue("BackOffice.CongressDocuments.Dropzone.Selected")'>
                                <input asp-for="CoverImage"
                                       id="updateCongressDocumentCoverImage"
                                       class="form-control d-none"
                                       type="file"
                                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                                <div class="text-center py-20">
                                    <i class="ri-image-add-line text-3xl text-primary-600"></i>
                                    <p class="mb-1 fw-medium">@L.GetStringValue("BackOffice.CongressDocuments.Dropzone.SelectCoverImage")</p>
                                    <small class="text-neutral-500">@L.GetStringValue("BackOffice.CongressDocuments.Help.UpdateCoverImage")</small>
                                    <div class="js-dropzone-file-name text-sm text-primary-600 mt-2"></div>
                                </div>
                            </div>
                            <span asp-validation-for="CoverImage" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-light-100 text-dark radius-8 px-20 py-11" data-bs-dismiss="modal">@L.GetStringValue("Common.Cancel")</button>
                    <button type="submit" class="btn btn-primary-600 radius-8 px-20 py-11">
                        <i class="ri-save-line me-1"></i>
                        @L.GetStringValue("BackOffice.CongressDocuments.Buttons.Update")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    private static string FormatFileSize(long? size)
    {
        if (!size.HasValue || size.Value <= 0) return "-";
        double bytes = size.Value;
        string[] units = { "B", "KB", "MB", "GB" };
        int unitIndex = 0;
        while (bytes >= 1024 && unitIndex < units.Length - 1) { bytes /= 1024; unitIndex++; }
        return $"{bytes:0.##} {units[unitIndex]}";
    }
}
