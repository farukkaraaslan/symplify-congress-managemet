@model Symplify.BackOffice.WebUI.Models.ParticipationCertificates.ParticipationCertificateTemplateSettingsPartialModel
@{
    string prefix = Model.TemplateCulture == "en-US" ? "en" : "tr";
    string bodyText = Model.Template?.BodyText ?? Model.DefaultBodyText;
    string mailSubject = Model.Template?.MailSubject ?? Model.DefaultMailSubject;
    string mailTitle = Model.Template?.MailTitle ?? Model.DefaultMailTitle;
    string mailBody = Model.Template?.MailBodyHtml ?? Model.DefaultMailBodyHtml;
    string fontColor = Model.Template?.NameFontColorHex ?? "#0F3791";
}
<form asp-action="SaveTemplate" asp-controller="ParticipationCertificates" asp-route-culture="@Model.CurrentCulture" method="post" enctype="multipart/form-data" class="row gy-4">
    @Html.AntiForgeryToken()
    <input type="hidden" name="congressId" value="@Model.CongressId" />
    <input type="hidden" name="templateCulture" value="@Model.TemplateCulture" />

    <div class="col-lg-5">
        <label class="form-label fw-semibold">@Model.CultureLabel PDF Template</label>
        <input class="form-control" type="file" name="templateFile" accept="application/pdf,.pdf" />
        <small class="text-neutral-500 d-block mt-1">
            @(Model.Template is null ? "Henüz PDF template yüklenmedi." : $"Aktif dosya: {Model.Template.FileName}")
        </small>
    </div>
    <div class="col-lg-3">
        <label class="form-label fw-semibold">Yazar Adı Rengi</label>
        <input class="form-control form-control-color w-100" type="color" name="fontColorHex" value="@fontColor" />
    </div>
    <div class="col-lg-4 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            @if (Model.Template?.IsDefault == true)
            {
                <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="@(prefix)DefaultTemplate" checked />
            }
            else
            {
                <input class="form-check-input" type="checkbox" name="isDefault" value="true" id="@(prefix)DefaultTemplate" />
            }
            <label class="form-check-label" for="@(prefix)DefaultTemplate">Varsayılan template</label>
        </div>
    </div>

    <div class="col-12">
        <label class="form-label fw-semibold">Sertifika Metni</label>
        <textarea class="form-control" name="bodyText" rows="3" maxlength="4000" required>@bodyText</textarea>
        <small class="text-neutral-500">Kullanılabilir değişken: <code>{{SUBMISSION_TYPE}}</code></small>
    </div>

    <div class="col-lg-6">
        <label class="form-label fw-semibold">Mail Konusu</label>
        <input class="form-control" name="mailSubject" maxlength="300" value="@mailSubject" required />
    </div>
    <div class="col-lg-6">
        <label class="form-label fw-semibold">Mail Başlığı</label>
        <input class="form-control" name="mailTitle" maxlength="300" value="@mailTitle" />
    </div>
    <div class="col-12">
        <label class="form-label fw-semibold">Mail İçeriği</label>
        <textarea class="form-control font-monospace" name="mailBodyHtml" rows="8" required>@mailBody</textarea>
        <small class="text-neutral-500 d-block mt-1">
            Zorunlu: <code>{{CERTIFICATE_LINK}}</code>. Diğerleri: <code>{{AUTHOR_NAME}}</code>, <code>{{CONGRESS_NAME}}</code>,
            <code>{{SUBMISSION_NUMBER}}</code>, <code>{{SUBMISSION_TITLE}}</code>, <code>{{CERTIFICATE_LANGUAGE}}</code>.
        </small>
    </div>
    <div class="col-12 d-flex justify-content-end">
        <button type="submit" class="btn btn-primary-600 px-24">
            <i class="ri-save-line me-1"></i> @Model.CultureLabel Ayarlarını Kaydet
        </button>
    </div>
</form>
