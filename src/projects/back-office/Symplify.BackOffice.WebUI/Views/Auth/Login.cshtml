@using Symplify.BackOffice.Application.Features.Auth.Constants
@using Symplify.BackOffice.WebUI.Localization
@model Symplify.BackOffice.WebUI.Models.Auth.LoginViewModel
@inject IBackOfficeViewLocalizer L
@{
    Layout = null;
    string culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    ViewData["ClientResourcePrefixes"] = new[] { "BackOffice.Auth." };
    string lightLogoUrl = !string.IsNullOrWhiteSpace(Model.OrganizationLogoLightUrl)
        ? Model.OrganizationLogoLightUrl!
        : Url.Content("~/assets/images/logo/symplify-logo-horizontal-light.svg");
    string darkLogoUrl = !string.IsNullOrWhiteSpace(Model.OrganizationLogoDarkUrl)
        ? Model.OrganizationLogoDarkUrl!
        : (!string.IsNullOrWhiteSpace(Model.OrganizationLogoLightUrl)
            ? Model.OrganizationLogoLightUrl!
            : Url.Content("~/assets/images/logo/symplify-logo-horizontal-dark.svg"));
    string logoAlt = Model.OrganizationShortName ?? "Symplify";
    string organizationDisplayName = !string.IsNullOrWhiteSpace(Model.OrganizationShortName) && !string.IsNullOrWhiteSpace(Model.OrganizationName)
        ? $"{Model.OrganizationShortName} - {Model.OrganizationName}"
        : (!string.IsNullOrWhiteSpace(Model.OrganizationName)
            ? Model.OrganizationName!
            : (Model.OrganizationShortName ?? string.Empty));
}
<!DOCTYPE html>
<html lang="@culture" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L[AuthResourceKeys.LoginPageTitle]</title>
    <link rel="icon" type="image/png" href="~/assets/images/favicon.png" sizes="16x16" />
    <link rel="stylesheet" href="~/lib/remixicon/fonts/remixicon.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="position-fixed end-0 top-0 p-24 z-3">
        @await Component.InvokeAsync("LanguageSwitcher")
    </div>

    <section class="auth d-flex flex-wrap min-vh-100">
        <div class="col-12 col-lg-6 d-lg-flex d-none align-items-center justify-content-center p-24">
            <div class="bg-base radius-16 shadow-sm p-40 w-100 d-flex align-items-center justify-content-center">
                <img src="~/assets/images/auth/auth-bg-1.svg" alt="Auth Illustration" class="w-100 max-w-464-px" />
            </div>
        </div>

        <div class="col-12 col-lg-6 d-flex align-items-center justify-content-center py-40 px-24">
            <div class="w-100 max-w-464-px mx-auto">
                <div class="card p-0 overflow-hidden position-relative radius-16 shadow-4 w-100">
                    <div class="card-body p-24">
                        <div class="mb-32 text-center">
                            <a asp-controller="Auth" asp-action="Login" asp-route-culture="@culture" asp-route-org="@Model.OrganizationSlug" class="brand-logo mb-24 max-w-290-px mx-auto d-block">
                                <img src="@lightLogoUrl" alt="@logoAlt" class="light-logo" />
                                <img src="@darkLogoUrl" alt="@logoAlt" class="dark-logo" />
                            </a>
                            <h4 class="mb-8">@L[AuthResourceKeys.LoginTitle]</h4>
                            @if (Model.HasOrganizationContext && !string.IsNullOrWhiteSpace(organizationDisplayName))
                            {
                                <p class="mb-0 text-secondary-light text-lg">@L[AuthResourceKeys.LoginOrganizationSubtitle, organizationDisplayName]</p>
                            }
                            else
                            {
                                <p class="mb-0 text-secondary-light text-lg">@L[AuthResourceKeys.LoginSubtitle]</p>
                            }
                        </div>

                        <form asp-action="Login" asp-controller="Auth" asp-route-culture="@culture" method="post" novalidate
                      autocomplete="off"
                      data-lpignore="true"
                      data-1p-ignore="true"
                      data-bwignore="true">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />
                            <input type="hidden" asp-for="OrganizationId" />
                            <input type="hidden" asp-for="OrganizationSlug" />
                            <input type="hidden" asp-for="OrganizationName" />
                            <input type="hidden" asp-for="OrganizationShortName" />
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger radius-12" role="alert"></div>

                            <div class="icon-field mb-16">
                                <span class="icon top-50 translate-middle-y">
                                    <iconify-icon icon="mage:email"></iconify-icon>
                                </span>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control h-56-px bg-neutral-50 radius-12"
                                       autocomplete="off"
                                       placeholder="@L[AuthResourceKeys.FieldEmail]"
                                       data-val="true"
                                       data-val-required="@L[AuthMessages.EmailRequired]"
                                       data-val-email="@L[AuthMessages.EmailInvalid]"
                                       data-lpignore="true"
                                       data-1p-ignore="true"
                                       data-bwignore="true"
                                       readonly
                                       onfocus="this.removeAttribute('readonly')"
                                       onmousedown="this.removeAttribute('readonly')"
                                       autocapitalize="none"
                                       spellcheck="false" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger text-sm d-block mt-n8 mb-16"></span>

                            <div class="position-relative mb-20">
                                <div class="icon-field">
                                    <span class="icon top-50 translate-middle-y">
                                        <iconify-icon icon="solar:lock-password-outline"></iconify-icon>
                                    </span>
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control h-56-px bg-neutral-50 radius-12"
                                           id="login-password"
                                           autocomplete="new-password"
                                           placeholder="@L[AuthResourceKeys.FieldPassword]"
                                           data-val="true"
                                           data-val-required="@L[AuthMessages.PasswordRequired]"
                                       data-lpignore="true"
                                       data-1p-ignore="true"
                                       data-bwignore="true"
                                       readonly
                                       onfocus="this.removeAttribute('readonly')"
                                       onmousedown="this.removeAttribute('readonly')"
                                       autocapitalize="none"
                                       spellcheck="false" />
                                </div>
                                <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light" data-toggle="#login-password"></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger text-sm d-block mt-n12 mb-20"></span>

                            <div class="d-flex justify-content-between gap-2">
                                <div class="form-check style-check d-flex align-items-center">
                                    <input asp-for="RememberMe" class="form-check-input border border-neutral-300" type="checkbox" />
                                    <label asp-for="RememberMe" class="form-check-label">@L[AuthResourceKeys.RememberMe]</label>
                                </div>
                                <a asp-action="ForgotPassword" asp-controller="Auth" asp-route-culture="@culture" asp-route-org="@Model.OrganizationSlug" class="text-primary-600 fw-medium">@L[AuthResourceKeys.ForgotPasswordLink]</a>
                            </div>

                            <button type="submit" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12 mt-32">
                                @L[AuthResourceKeys.LoginButton]
                            </button>

                            <div class="mt-32 text-center text-sm">
                                <p class="mb-0">
                                    @L[AuthResourceKeys.NoAccount]
                                    <a asp-action="Register" asp-controller="Auth" asp-route-culture="@culture" asp-route-org="@Model.OrganizationSlug" class="text-primary-600 fw-semibold">@L[AuthResourceKeys.CreateAccountLink]</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-ui/dist/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/iconify-icon/dist/iconify-icon.min.js"></script>
    <script src="~/js/app.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/features/auth/auth-pages.js" asp-append-version="true"></script>
</body>
</html>
