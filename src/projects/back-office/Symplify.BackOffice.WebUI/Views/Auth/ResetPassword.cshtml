@using Symplify.BackOffice.Application.Features.Auth.Constants
@using Symplify.BackOffice.WebUI.Localization
@model Symplify.BackOffice.WebUI.Models.Auth.ResetPasswordViewModel
@inject IBackOfficeViewLocalizer L
@{
    Layout = null;
    string culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    ViewData["ClientResourcePrefixes"] = new[] { "BackOffice.Auth." };
    string lightLogoUrl = !string.IsNullOrWhiteSpace(Model.OrganizationLogoLightUrl)
        ? Model.OrganizationLogoLightUrl!
        : Url.Content("~/assets/images/logo/symplify-logo-horizontal-light.svg");
    string darkLogoUrl = !string.IsNullOrWhiteSpace(Model.OrganizationLogoDarkUrl)
        ? Model.OrganizationLogoDarkUrl!
        : (!string.IsNullOrWhiteSpace(Model.OrganizationLogoLightUrl)
            ? Model.OrganizationLogoLightUrl!
            : Url.Content("~/assets/images/logo/symplify-logo-horizontal-dark.svg"));
    string logoAlt = Model.OrganizationShortName ?? "Symplify";
    string organizationDisplayName = !string.IsNullOrWhiteSpace(Model.OrganizationShortName) && !string.IsNullOrWhiteSpace(Model.OrganizationName)
        ? $"{Model.OrganizationShortName} - {Model.OrganizationName}"
        : (!string.IsNullOrWhiteSpace(Model.OrganizationName)
            ? Model.OrganizationName!
            : (Model.OrganizationShortName ?? string.Empty));
}
<!DOCTYPE html>
<html lang="@culture" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L[AuthResourceKeys.ResetPageTitle]</title>
    <link rel="icon" type="image/png" href="~/assets/images/favicon.png" sizes="16x16" />
    <link rel="stylesheet" href="~/lib/remixicon/fonts/remixicon.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="position-fixed end-0 top-0 p-24 z-3">
        @await Component.InvokeAsync("LanguageSwitcher")
    </div>

    <section class="auth d-flex flex-wrap min-vh-100">
        <div class="auth-left d-lg-block d-none">
            <div class="d-flex align-items-center flex-column h-100 justify-content-center">
                <img src="~/assets/images/auth/auth-bg-2.svg" alt="" class="w-100 max-w-464-px" />
            </div>
        </div>
        <div class="auth-right py-32 px-24 d-flex flex-column justify-content-center align-items-center">
            <div class="max-w-464-px mx-auto w-100">
                <div class="text-center">
                    <a asp-controller="Auth" asp-action="Login" asp-route-culture="@culture" asp-route-org="@Model.OrganizationSlug" class="brand-logo mb-40 max-w-290-px mx-auto d-block">
                        <img src="@lightLogoUrl" alt="@logoAlt" class="light-logo" />
                        <img src="@darkLogoUrl" alt="@logoAlt" class="dark-logo" />
                    </a>
                    <h4 class="mb-12">@L[AuthResourceKeys.ResetTitle]</h4>
                    @if (Model.HasOrganizationContext && !string.IsNullOrWhiteSpace(organizationDisplayName))
                    {
                        <p class="mb-32 text-secondary-light text-lg">@L[AuthResourceKeys.ResetOrganizationSubtitle, organizationDisplayName]</p>
                    }
                    else
                    {
                        <p class="mb-32 text-secondary-light text-lg">@L[AuthResourceKeys.ResetSubtitle]</p>
                    }
                </div>

                @if (Model.PasswordChanged)
                {
                    <div class="alert alert-success radius-12" role="alert">@L[AuthResourceKeys.ResetSuccess]</div>
                    <div class="text-center">
                        <a asp-action="Login" asp-controller="Auth" asp-route-culture="@culture" asp-route-org="@Model.OrganizationSlug" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12 mt-16">@L[AuthResourceKeys.BackToLogin]</a>
                    </div>
                }
                else
                {
                    <form asp-action="ResetPassword" asp-controller="Auth" asp-route-culture="@culture" method="post" novalidate
                      autocomplete="off"
                      data-lpignore="true"
                      data-1p-ignore="true"
                      data-bwignore="true">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />
                        <input type="hidden" asp-for="OrganizationId" />
                        <input type="hidden" asp-for="OrganizationSlug" />
                        <input type="hidden" asp-for="OrganizationName" />
                        <input type="hidden" asp-for="OrganizationShortName" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger radius-12" role="alert"></div>

                        <div class="mb-16">
                            <div class="icon-field">
                                <span class="icon top-50 translate-middle-y">
                                    <iconify-icon icon="mage:email"></iconify-icon>
                                </span>
                                <input asp-for="Email"
                                       type="email"
                                       class="form-control h-56-px bg-neutral-50 radius-12"
                                       placeholder="@L[AuthResourceKeys.FieldEmail]"
                                       autocomplete="off"
                                       data-val="true"
                                       data-val-required="@L[AuthMessages.EmailRequired]"
                                       data-val-email="@L[AuthMessages.EmailInvalid]"
                                       data-lpignore="true"
                                       data-1p-ignore="true"
                                       data-bwignore="true"
                                       readonly
                                       onfocus="this.removeAttribute('readonly')"
                                       onmousedown="this.removeAttribute('readonly')"
                                       autocapitalize="none"
                                       spellcheck="false" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger text-sm d-block mt-4"></span>
                        </div>

                        <div class="mb-16">
                            <div class="position-relative">
                                <div class="icon-field">
                                    <span class="icon top-50 translate-middle-y">
                                        <iconify-icon icon="solar:lock-password-outline"></iconify-icon>
                                    </span>
                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control h-56-px bg-neutral-50 radius-12 pe-48"
                                           id="reset-password"
                                           placeholder="@L[AuthResourceKeys.FieldPassword]"
                                           autocomplete="new-password"
                                           data-val="true"
                                           data-val-required="@L[AuthMessages.PasswordRequired]"
                                       data-lpignore="true"
                                       data-1p-ignore="true"
                                       data-bwignore="true"
                                       readonly
                                       onfocus="this.removeAttribute('readonly')"
                                       onmousedown="this.removeAttribute('readonly')"
                                       autocapitalize="none"
                                       spellcheck="false" />
                                </div>
                                <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light"
                                      data-toggle="#reset-password"></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger text-sm d-block mt-4"></span>
                        </div>

                        <div class="mb-16">
                            <div class="position-relative">
                                <div class="icon-field">
                                    <span class="icon top-50 translate-middle-y">
                                        <iconify-icon icon="solar:lock-password-outline"></iconify-icon>
                                    </span>
                                    <input asp-for="ConfirmPassword"
                                           type="password"
                                           class="form-control h-56-px bg-neutral-50 radius-12 pe-48"
                                           id="reset-confirm-password"
                                           placeholder="@L[AuthResourceKeys.FieldConfirmPassword]"
                                           autocomplete="new-password"
                                           data-val="true"
                                           data-val-required="@L[AuthMessages.ConfirmPasswordRequired]"
                                           data-val-equalto="@L[AuthMessages.PasswordsDoNotMatch]"
                                           data-val-equalto-other="*.Password"
                                       data-lpignore="true"
                                       data-1p-ignore="true"
                                       data-bwignore="true"
                                       readonly
                                       onfocus="this.removeAttribute('readonly')"
                                       onmousedown="this.removeAttribute('readonly')"
                                       autocapitalize="none"
                                       spellcheck="false" />
                                </div>
                                <span class="toggle-password ri-eye-line cursor-pointer position-absolute end-0 top-50 translate-middle-y me-16 text-secondary-light"
                                      data-toggle="#reset-confirm-password"></span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger text-sm d-block mt-4"></span>
                        </div>

                        <button type="submit" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12 mt-16">
                            @L[AuthResourceKeys.ResetButton]
                        </button>
                    </form>
                }
            </div>
        </div>
    </section>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-ui/dist/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/iconify-icon/dist/iconify-icon.min.js"></script>
    <script src="~/js/app.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await Html.PartialAsync("_LocalizationScripts")
    <script src="~/js/features/auth/auth-pages.js" asp-append-version="true"></script>
</body>
</html>
