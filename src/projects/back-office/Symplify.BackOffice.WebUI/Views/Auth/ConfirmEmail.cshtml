@using Symplify.BackOffice.Application.Features.Auth.Constants
@using Symplify.BackOffice.WebUI.Localization
@model Symplify.BackOffice.WebUI.Models.Auth.ConfirmEmailViewModel
@inject IBackOfficeViewLocalizer L
@{
    Layout = null;
    string culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    ViewData["ClientResourcePrefixes"] = new[] { "BackOffice.Auth." };
}
<!DOCTYPE html>
<html lang="@culture" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L[AuthResourceKeys.ConfirmPageTitle]</title>
    <link rel="icon" type="image/png" href="~/assets/images/favicon.png" sizes="16x16" />
    <link rel="stylesheet" href="~/lib/remixicon/fonts/remixicon.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <section class="auth d-flex flex-wrap min-vh-100">
        <div class="auth-right py-32 px-24 d-flex flex-column justify-content-center align-items-center w-100">
            <div class="max-w-464-px mx-auto w-100 text-center">
                <a asp-controller="Auth" asp-action="Login" asp-route-culture="@culture" class="brand-logo mb-40 max-w-290-px mx-auto d-block">
                    <img src="~/assets/images/logo/symplify-logo-horizontal-light.svg" alt="" class="light-logo" />
                    <img src="~/assets/images/logo/symplify-logo-horizontal-dark.svg" alt="" class="dark-logo" />
                </a>

                @if (Model.Success)
                {
                    <span class="w-72-px h-72-px bg-success-50 text-success-600 rounded-circle d-inline-flex align-items-center justify-content-center mb-24"><i class="ri-check-line text-3xl"></i></span>
                    <h4 class="mb-12">@L[AuthResourceKeys.ConfirmSuccessTitle]</h4>
                    <p class="text-secondary-light text-lg">@L[AuthResourceKeys.ConfirmSuccessMessage]</p>
                }
                else
                {
                    <span class="w-72-px h-72-px bg-danger-50 text-danger-600 rounded-circle d-inline-flex align-items-center justify-content-center mb-24"><i class="ri-close-line text-3xl"></i></span>
                    <h4 class="mb-12">@L[AuthResourceKeys.ConfirmFailedTitle]</h4>
                    <p class="text-secondary-light text-lg">@L[AuthResourceKeys.ConfirmFailedMessage]</p>
                }

                <a asp-action="Login" asp-controller="Auth" asp-route-culture="@culture" class="btn btn-primary text-sm btn-sm px-12 py-16 w-100 radius-12 mt-24">@L[AuthResourceKeys.BackToLogin]</a>
            </div>
        </div>
    </section>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-ui/dist/jquery-ui.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/iconify-icon/dist/iconify-icon.min.js"></script>
    <script src="~/js/app.js"></script>
    @await Html.PartialAsync("_LocalizationScripts")
</body>
</html>
