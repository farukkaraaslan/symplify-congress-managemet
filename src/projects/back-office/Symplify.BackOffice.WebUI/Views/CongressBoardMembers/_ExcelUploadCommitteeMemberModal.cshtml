@model Symplify.BackOffice.WebUI.Models.CongressBoardMembers.UploadCongressBoardMembersExcelViewModel
@inject Symplify.BackOffice.WebUI.Localization.IBackOfficeViewLocalizer L

@{
    string currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    string postUrl = Url.Action("UploadExcel", "CongressBoardMembers", new { culture = currentCulture }) ?? $"/{currentCulture}/CongressBoardMembers/UploadExcel";
    string templateUrl = Url.Action("DownloadExcelTemplate", "CongressBoardMembers", new { culture = currentCulture, congressId = Model.CongressId }) ?? $"/{currentCulture}/CongressBoardMembers/DownloadExcelTemplate?congressId={Model.CongressId}";
}

<div class="modal fade" id="committeeExcelUploadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form id="uploadCongressBoardMembersExcelForm" action="@postUrl" method="post" enctype="multipart/form-data" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="CongressId" />
                <div class="modal-header">
                    <div>
                        <h6 class="modal-title">@L.GetStringValue("BackOffice.CongressBoardMembers.ExcelUpload.Title")</h6>
                        <small class="text-neutral-500 d-block mt-1">@L.GetStringValue("BackOffice.CongressBoardMembers.ExcelUpload.Description")</small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label='@L.GetStringValue("Common.Close")'></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info bg-primary-50 border-primary-100 text-primary-700 d-flex align-items-start gap-2 mb-4">
                        <i class="ri-information-line text-lg mt-1"></i>
                        <div>@L.GetStringValue("BackOffice.CongressBoardMembers.ExcelUpload.Help")</div>
                    </div>
                    <div class="card border shadow-none mb-4">
                        <div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <h6 class="text-md mb-0">@L.GetStringValue("BackOffice.CongressBoardMembers.ExcelUpload.TemplateTitle")</h6>
                                <small class="text-neutral-500">@L.GetStringValue("BackOffice.CongressBoardMembers.ExcelUpload.TemplateDescription")</small>
                            </div>
                            <a class="btn btn-outline-neutral-900 radius-8 px-20 py-11 d-flex align-items-center gap-2" href="@templateUrl">
                                <i class="ri-download-2-line me-1"></i> @L.GetStringValue("BackOffice.CongressBoardMembers.Buttons.ExcelTemplate")
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table bordered-table mb-0">
                                    <thead><tr><th>Kurul Türü</th><th>Akademik Ünvan</th><th>Ad Soyad</th><th>Kurum</th><th>Durum</th><th>Açıklama</th></tr></thead>
                                    <tbody><tr><td>Bilim Kurulu</td><td>Prof. Dr.</td><td>Ad Soyad</td><td>Üniversite / Kurum</td><td>Aktif</td><td>İsteğe bağlı</td></tr></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="card border shadow-none">
                        <div class="card-header border-bottom"><h6 class="text-md mb-0">@L.GetStringValue("BackOffice.CongressBoardMembers.ExcelUpload.FileTitle")</h6></div>
                        <div class="card-body">
                            <label class="border border-neutral-200 rounded-3 p-40 d-flex flex-column align-items-center justify-content-center text-center bg-neutral-50 cursor-pointer">
                                <i class="ri-file-excel-2-line text-4xl text-success mb-2"></i>
                                <span class="btn btn-outline-primary-600 radius-8 px-20 py-11 d-inline-flex align-items-center gap-2 mt-2">@L.GetStringValue("BackOffice.CongressBoardMembers.Buttons.SelectExcel")</span>
                                <span class="text-xs text-neutral-500 mt-2">@L.GetStringValue("BackOffice.CongressBoardMembers.ExcelUpload.FileHelp")</span>
                                <input asp-for="File" type="file" class="d-none" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                            </label>
                            <span asp-validation-for="File" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mt-3 d-none" data-excel-upload-result></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light-100 text-dark radius-8 px-20 py-11 d-flex align-items-center gap-2" data-bs-dismiss="modal">@L.GetStringValue("Common.Cancel")</button>
                    <button type="submit" class="btn btn-primary-600 radius-8 px-20 py-11 d-flex align-items-center gap-2"><i class="ri-upload-2-line me-1"></i> @L.GetStringValue("BackOffice.CongressBoardMembers.Buttons.Upload")</button>
                </div>
            </form>
        </div>
    </div>
</div>

