@using Symplify.BackOffice.Application.Features.Submissions.Constants
@using Symplify.BackOffice.Application.Features.Submissions.Queries.GetManage
@using Symplify.BackOffice.Application.Services.Workflow
@using Symplify.BackOffice.WebUI.Localization
@model Symplify.BackOffice.WebUI.Models.Submissions.SubmissionManageViewModel
@inject IBackOfficeViewLocalizer L

@{
    ViewData["Title"] = L.GetStringValue(SubmissionManagementResourceKeys.PageTitle);
    ViewData["ClientResourcePrefixes"] = new[] { "BackOffice.Submissions.Management.Editor." };
    string? currentCulture = Context.Request.RouteValues["culture"]?.ToString();
    GetManageSubmissionResponse detail = Model.Detail;

    ManageSubmissionAuthorDto? correspondingAuthor = detail.Authors.FirstOrDefault(item => item.IsCorrespondingAuthor) ?? detail.Authors.FirstOrDefault();
    int reviewerCount = detail.Reviewers.Count;
    int completedReviewerCount = detail.Reviewers.Count(item => item.Evaluation?.CompletedAt is not null);
    string lastActionDate = detail.Histories.Any()
        ? FormatDate(detail.Histories.Max(item => item.PerformedAt))
        : FormatDate(detail.UpdatedDate ?? detail.SubmittedAt ?? detail.CreatedDate);
    string transactionStatusName = string.IsNullOrWhiteSpace(detail.TransactionStatusName) ? T(SubmissionManagementResourceKeys.Draft) : detail.TransactionStatusName;
    string paymentStatusName = string.IsNullOrWhiteSpace(detail.PaymentStatusName) ? "-" : detail.PaymentStatusName;
    string editorEvaluationUrl = Url.Action("EditorEvaluation", "SubmissionManagement", new { culture = currentCulture, id = detail.Id }) ?? $"/{currentCulture}/submission-management/{detail.Id}/editor-evaluation";
    AllowedWorkflowTransitionDto? approveTransition = detail.WorkflowTransitions.FirstOrDefault(item => IsCode(NormalizeCode(item.ToStatusCode), "ACCEPTED"));
    AllowedWorkflowTransitionDto? completeTransition = detail.WorkflowTransitions.FirstOrDefault(item => IsCode(NormalizeCode(item.ToStatusCode), "COMPLETED"));
    string currentStatusCode = NormalizeCode(detail.TransactionStatusCode);
    string currentPaymentStatusCode = NormalizeCode(detail.PaymentStatusCode);
    bool isAcceptedStatus = IsCode(currentStatusCode, "ACCEPTED");
    bool isPaymentPendingStatus = IsCode(currentPaymentStatusCode, "PAYMENT_PENDING", "PENDING", "WAITING_PAYMENT")
        || IsCode(currentStatusCode, "PAYMENT_PENDING");
    bool isPaymentCompleted = IsCode(currentPaymentStatusCode, "PAID", "PAYMENT_PAID", "PAYMENT_COMPLETED", "APPROVED", "PAYMENT_APPROVED", "COMPLETED")
        || IsPaidPaymentStatusName(paymentStatusName);
    bool isCompletedStatus = IsCode(currentStatusCode, "COMPLETED");
    bool isRejectedStatus = IsCode(currentStatusCode, "REJECTED");
    bool isTerminalStatus = IsCode(currentStatusCode, "REJECTED", "WITHDRAWN", "COMPLETED");
    bool isApprovalLockedStatus = isAcceptedStatus || isPaymentPendingStatus || isPaymentCompleted || isCompletedStatus || isRejectedStatus || IsCode(currentStatusCode, "WITHDRAWN");
    bool hasCompletedEvaluation = detail.Evaluations.Any(item => item.CompletedAt.HasValue);
    bool canShowApprove = approveTransition is not null && !isApprovalLockedStatus;
    bool canApprove = canShowApprove && approveTransition!.IsAllowed && hasCompletedEvaluation;
    bool canReject = !isRejectedStatus;
    bool canRestartRejectedProcess = isRejectedStatus;
    bool canCompletePayment = isAcceptedStatus && !isPaymentCompleted && !isRejectedStatus;
    bool canRevertPayment = isPaymentCompleted && !isRejectedStatus;
    bool canComplete = completeTransition is not null && completeTransition.IsAllowed && !isTerminalStatus;
    string focusTitleKey = isCompletedStatus
        ? SubmissionManagementResourceKeys.FocusCompletedTitle
        : isPaymentPendingStatus
            ? SubmissionManagementResourceKeys.FocusPaymentTitle
            : isAcceptedStatus
                ? SubmissionManagementResourceKeys.FocusAcceptedTitle
                : isRejectedStatus
                    ? SubmissionManagementResourceKeys.FocusRejectedTitle
                    : SubmissionManagementResourceKeys.FocusTitle;
    string focusDescriptionKey = isCompletedStatus
        ? SubmissionManagementResourceKeys.FocusCompletedDescription
        : isPaymentPendingStatus
            ? SubmissionManagementResourceKeys.FocusPaymentDescription
            : isAcceptedStatus
                ? SubmissionManagementResourceKeys.FocusAcceptedDescription
                : isRejectedStatus
                    ? SubmissionManagementResourceKeys.FocusRejectedDescription
                    : SubmissionManagementResourceKeys.FocusDescription;
    string focusIconClass = isCompletedStatus || isAcceptedStatus
        ? "bg-success-100 text-success-600"
        : isRejectedStatus
            ? "bg-danger-100 text-danger-600"
            : isPaymentPendingStatus
                ? "bg-info-100 text-info-600"
                : "bg-warning-100 text-warning-600";
    string focusIcon = isCompletedStatus
        ? "ri-check-double-line"
        : isAcceptedStatus
            ? "ri-checkbox-circle-line"
            : isRejectedStatus
                ? "ri-close-circle-line"
                : isPaymentPendingStatus
                    ? "ri-bank-card-line"
                    : "ri-user-star-line";
    string focusBadgeClass = isCompletedStatus || isAcceptedStatus
        ? "bg-success-100 text-success-600"
        : isRejectedStatus
            ? "bg-danger-100 text-danger-600"
            : isPaymentPendingStatus
                ? "bg-info-100 text-info-600"
                : "bg-warning-100 text-warning-600";
    string focusBadgeText = isCompletedStatus
        ? T(SubmissionManagementResourceKeys.FocusCompletedBadge)
        : isPaymentPendingStatus
            ? T(SubmissionManagementResourceKeys.FocusPaymentBadge)
            : isAcceptedStatus
                ? T(SubmissionManagementResourceKeys.FocusAcceptedBadge)
                : isRejectedStatus
                    ? T(SubmissionManagementResourceKeys.FocusRejectedBadge)
                    : string.Format(T(SubmissionManagementResourceKeys.ReviewCompletionFormat), completedReviewerCount, reviewerCount);
    string editorStatusTextClass = isCompletedStatus || isAcceptedStatus
        ? "text-success-600"
        : isRejectedStatus
            ? "text-danger-600"
            : isPaymentPendingStatus
                ? "text-info-600"
                : "text-warning-600";

    // Hakem atama workflow transition listesine bağlı olmamalı.
    // Çünkü editör bu ekrandan değerlendirme öncesinde isterse doğrudan hakem atayabilmelidir.
    // Sadece final statülerde ve tamamlanmış değerlendirme varken engellenir.
    bool canAssignReviewer = !hasCompletedEvaluation && !isTerminalStatus;
    bool canCreateEditorEvaluation = !hasCompletedEvaluation && !isTerminalStatus;
    bool showReviewerAssignmentTab = canAssignReviewer || detail.Reviewers.Any();
    bool isExhibitionApplication = detail.IsExhibitionApplication;
    ManageSubmissionFileDto? exhibitionImageFile = detail.Files.FirstOrDefault(item =>
        string.Equals(item.FileKind, "ExhibitionImage", StringComparison.OrdinalIgnoreCase) ||
        (!string.IsNullOrWhiteSpace(item.ContentType) && item.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)));
    string? exhibitionImagePreviewUrl = exhibitionImageFile is null
        ? null
        : Url.Action("PreviewFile", "SubmissionManagementFiles", new { culture = currentCulture, fileId = exhibitionImageFile.Id });
    string? exhibitionImageDownloadUrl = exhibitionImageFile is null
        ? null
        : Url.Action("DownloadFile", "SubmissionManagementFiles", new { culture = currentCulture, fileId = exhibitionImageFile.Id });
}

<div class="dashboard-main-body">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
        <div>
            <h6 class="fw-semibold mb-0">@L[SubmissionManagementResourceKeys.PageTitle]</h6>
            <small class="text-neutral-500">@L[SubmissionManagementResourceKeys.PageSubtitle]</small>
        </div>
        <ul class="d-flex align-items-center gap-2 mb-0 list-unstyled">
            <li class="fw-medium">
                <a class="d-flex align-items-center gap-1 hover-text-primary text-neutral-600" href="@Url.Action("Index", "Home", new { culture = currentCulture })">
                    <iconify-icon class="icon text-lg" icon="solar:home-smile-angle-outline"></iconify-icon>
                    @L[SubmissionManagementResourceKeys.BreadcrumbDashboard]
                </a>
            </li>
            <li>-</li>
            <li class="fw-medium"><a class="hover-text-primary text-neutral-600" href="@Url.Action("Index", "SubmissionManagement", new { culture = currentCulture })">@L[SubmissionManagementResourceKeys.BreadcrumbIndex]</a></li>
            <li>-</li>
            <li class="fw-medium">@L[SubmissionManagementResourceKeys.BreadcrumbDetail]</li>
        </ul>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div data-symplify-toast data-toast-icon="success" data-toast-title="@TempData["SuccessMessage"]"></div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div data-symplify-toast data-toast-icon="error" data-toast-title="@TempData["ErrorMessage"]"></div>
    }

    <div class="card border shadow-none radius-16 mb-24">
        <div class="card-body p-24 p-lg-32">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-24">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-16">
                        <span class="badge bg-primary-50 text-primary-600 radius-8 px-12 py-7 fw-semibold">@(string.IsNullOrWhiteSpace(detail.SubmissionNumber) ? $"#{detail.Id.ToString()[..8].ToUpperInvariant()}" : $"#{detail.SubmissionNumber}")</span>
                        <span class="badge @detail.TransactionStatusBadgeClass radius-8 px-12 py-7 fw-semibold">@transactionStatusName</span>
                        <span class="badge @detail.PaymentStatusBadgeClass radius-8 px-12 py-7 fw-semibold">@paymentStatusName</span>
                    </div>

                    <h3 class="mb-16 fw-semibold text-primary-light line-height-1-25">@detail.Title</h3>

                    <div class="d-flex align-items-center flex-wrap gap-3 text-sm text-neutral-600">
                        <span class="d-inline-flex align-items-center gap-1"><i class="ri-building-4-line text-primary-600"></i> @detail.CongressName</span>
                        <span class="d-inline-flex align-items-center gap-1"><i class="@(isExhibitionApplication ? "ri-gallery-line" : "ri-presentation-line") text-primary-600"></i> @detail.SubmissionTypeName</span>
                        <span class="d-inline-flex align-items-center gap-1"><i class="ri-user-star-line text-primary-600"></i> @L[SubmissionManagementResourceKeys.CorrespondingAuthor]: @(correspondingAuthor?.FullName ?? "-")</span>
                        <span class="d-inline-flex align-items-center gap-1"><i class="ri-calendar-line text-primary-600"></i> @L[SubmissionManagementResourceKeys.SubmittedAt]: @FormatDate(detail.SubmittedAt ?? detail.CreatedDate)</span>
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-end gap-2 d-print-none">
                    <a href="@Url.Action("Index", "SubmissionManagement", new { culture = currentCulture })" class="btn btn-outline-neutral-900 radius-8 px-18 py-10 d-inline-flex align-items-center gap-2">
                        <i class="ri-arrow-left-line"></i> @L[SubmissionManagementResourceKeys.BackToList]
                    </a>
                </div>
            </div>

            <div class="row gy-3">
                <div class="col-xl-3 col-md-6">
                    <div class="border border-neutral-200 bg-neutral-50 radius-12 p-18 h-100">
                        <div class="d-flex align-items-center gap-3">
                            <span class="w-40-px h-40-px rounded-circle bg-primary-50 text-primary-600 d-flex align-items-center justify-content-center flex-shrink-0"><i class="@(isExhibitionApplication ? "ri-gallery-line" : "ri-file-list-3-line")"></i></span>
                            <div>
                                <span class="text-sm text-secondary-light d-block mb-4">@L[SubmissionManagementResourceKeys.SubmissionType]</span>
                                <h6 class="mb-0 fw-semibold text-neutral-900">@detail.SubmissionTypeName</h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="border border-neutral-200 bg-neutral-50 radius-12 p-18 h-100">
                        <div class="d-flex align-items-center gap-3">
                            <span class="w-40-px h-40-px rounded-circle bg-info-50 text-info-600 d-flex align-items-center justify-content-center flex-shrink-0"><i class="@(isExhibitionApplication ? "ri-ruler-line" : "ri-bookmark-3-line")"></i></span>
                            <div>
                                <span class="text-sm text-secondary-light d-block mb-4">@(isExhibitionApplication ? T("BackOffice.Submissions.Management.Editor.Exhibition.Dimensions") : T(SubmissionManagementResourceKeys.Topic))</span>
                                <h6 class="mb-0 fw-semibold text-neutral-900">@(isExhibitionApplication ? (detail.ExhibitionDetail?.Dimensions ?? "-") : detail.TopicName)</h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="border border-neutral-200 bg-neutral-50 radius-12 p-18 h-100">
                        <div class="d-flex align-items-center gap-3">
                            <span class="w-40-px h-40-px rounded-circle bg-purple-50 text-purple d-flex align-items-center justify-content-center flex-shrink-0"><i class="@(isExhibitionApplication ? "ri-brush-line" : "ri-team-line")"></i></span>
                            <div>
                                <span class="text-sm text-secondary-light d-block mb-4">@(isExhibitionApplication ? T("BackOffice.Submissions.Management.Editor.Exhibition.Technique") : T(SubmissionManagementResourceKeys.StatReviewerStatus))</span>
                                <h6 class="mb-0 fw-semibold text-neutral-900">@(isExhibitionApplication ? (detail.ExhibitionDetail?.Technique ?? "-") : string.Format(T(SubmissionManagementResourceKeys.ReviewCompletedFormat), completedReviewerCount, reviewerCount))</h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="border border-neutral-200 bg-neutral-50 radius-12 p-18 h-100">
                        <div class="d-flex align-items-center gap-3">
                            <span class="w-40-px h-40-px rounded-circle bg-success-50 text-success-600 d-flex align-items-center justify-content-center flex-shrink-0"><i class="ri-medal-line"></i></span>
                            <div>
                                <span class="text-sm text-secondary-light d-block mb-4">@L[SubmissionManagementResourceKeys.StatAverageScore]</span>
                                <h6 class="mb-0 fw-semibold text-success-600">@(detail.AverageScore.HasValue ? $"{detail.AverageScore.Value:0.##}" : "-")</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border shadow-none radius-12 mb-24 d-print-none" id="paymentActions">
        <div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h6 class="text-md mb-1">@L[SubmissionManagementResourceKeys.FocusTitle]</h6>
                <span class="text-sm text-neutral-500">@L[focusDescriptionKey]</span>
            </div>
            <span class="badge @focusBadgeClass radius-8 px-12 py-7">@focusBadgeText</span>
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2">
                @if (canShowApprove)
                {
                    <button type="button" class="btn btn-success-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#approveSubmissionModal" disabled="@(!canApprove)" title="@(canApprove ? null : L.GetStringValue(SubmissionManagementResourceKeys.DecisionEvaluationRequired))">
                        <i class="ri-check-line"></i> @L[SubmissionManagementResourceKeys.ActionApprove]
                    </button>
                }
                @if (canReject)
                {
                    <button type="button" class="btn btn-danger-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#rejectSubmissionModal">
                        <i class="ri-close-line"></i> @L[SubmissionManagementResourceKeys.ActionReject]
                    </button>
                }
                @if (canRestartRejectedProcess)
                {
                    <button type="button" class="btn btn-warning-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#restartRejectedProcessModal">
                        <i class="ri-refresh-line"></i> @L[SubmissionManagementResourceKeys.ActionRestartProcess]
                    </button>
                }
                @if (canAssignReviewer)
                {
                    <button type="button" class="btn btn-outline-primary-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#assignReviewerModal">
                        <i class="ri-user-add-line"></i> @L[SubmissionManagementResourceKeys.ActionAssignReviewer]
                    </button>
                }
                @if (canCreateEditorEvaluation)
                {
                    <a class="btn btn-warning-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" href="@editorEvaluationUrl">
                        <i class="ri-edit-2-line"></i> @L[SubmissionManagementResourceKeys.ActionEditorEvaluation]
                    </a>
                }
                @if (canCompletePayment)
                {
                    <button type="button" class="btn btn-success-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#paymentSubmissionModal">
                        <i class="ri-bank-card-line"></i> @L[SubmissionManagementResourceKeys.ActionMarkPaymentCompleted]
                    </button>
                }
                @if (canRevertPayment)
                {
                    <button type="button" class="btn btn-warning-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#revertPaymentSubmissionModal">
                        <i class="ri-arrow-go-back-line"></i> @L[SubmissionManagementResourceKeys.ActionRevertPayment]
                    </button>
                }
                @if (completeTransition is not null && !isTerminalStatus)
                {
                    <button type="button" class="btn btn-success-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#completeSubmissionModal" disabled="@(!canComplete)">
                        <i class="ri-check-double-line"></i> @ResolveTransitionActionText(completeTransition)
                    </button>
                }
                <button type="button" class="btn btn-outline-neutral-900 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2" data-submission-tab-target="reviews-tab">
                    <i class="ri-chat-check-line"></i> @L[SubmissionManagementResourceKeys.ActionViewEvaluations]
                </button>
            </div>
            @if (canShowApprove && !canApprove)
            {
                <small class="d-block text-warning-600 mt-2">@L[SubmissionManagementResourceKeys.DecisionEvaluationRequired]</small>
            }
            @if (!isTerminalStatus && hasCompletedEvaluation)
            {
                <small class="d-block text-neutral-500 mt-2">@L[SubmissionManagementResourceKeys.ReviewerAssignmentDisabledAfterEvaluation]</small>
            }
        </div>
    </div>

    <div class="card border shadow-none radius-16" id="submissionDetailCard">
        <div class="card-header border-bottom p-0">
            <ul class="nav nav-pills p-12 gap-2" id="submissionDetailTab" role="tablist">
                <li class="nav-item" role="presentation"><button class="nav-link active d-flex align-items-center gap-2 px-16 py-10" id="summary-tab" data-bs-toggle="pill" data-bs-target="#summaryTab" type="button" role="tab"><i class="ri-file-list-3-line"></i> @L[SubmissionManagementResourceKeys.TabSummary]</button></li>
                @if (showReviewerAssignmentTab)
                {
                    <li class="nav-item" role="presentation"><button class="nav-link d-flex align-items-center gap-2 px-16 py-10" id="reviewer-tab" data-bs-toggle="pill" data-bs-target="#reviewerTab" type="button" role="tab"><i class="ri-user-add-line"></i> @L[SubmissionManagementResourceKeys.TabReviewerAssignment]</button></li>
                }
                <li class="nav-item" role="presentation"><button class="nav-link d-flex align-items-center gap-2 px-16 py-10" id="reviews-tab" data-bs-toggle="pill" data-bs-target="#reviewsTab" type="button" role="tab"><i class="ri-medal-line"></i> @L[SubmissionManagementResourceKeys.TabEvaluations]</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link d-flex align-items-center gap-2 px-16 py-10" id="files-tab" data-bs-toggle="pill" data-bs-target="#filesTab" type="button" role="tab"><i class="ri-folder-2-line"></i> @L[SubmissionManagementResourceKeys.TabFiles]</button></li>
                <li class="nav-item" role="presentation"><button class="nav-link d-flex align-items-center gap-2 px-16 py-10" id="history-tab" data-bs-toggle="pill" data-bs-target="#historyTab" type="button" role="tab"><i class="ri-history-line"></i> @L[SubmissionManagementResourceKeys.TabHistory]</button></li>
            </ul>
        </div>

        <div class="card-body p-24">
            <div class="tab-content" id="submissionDetailTabContent">
                <div class="tab-pane fade show active" id="summaryTab" role="tabpanel" aria-labelledby="summary-tab" tabindex="0">
                    @if (isExhibitionApplication)
                    {
                        <div class="row gy-4">
                            <div class="col-xl-7">
                                <div class="card border shadow-none radius-12 h-100">
                                    <div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div>
                                            <h6 class="text-md mb-1">@T("BackOffice.Submissions.Management.Editor.Exhibition.ImageTitle")</h6>
                                            <span class="text-sm text-neutral-500">@T("BackOffice.Submissions.Management.Editor.Exhibition.ImageDescription")</span>
                                        </div>
                                        <span class="badge bg-primary-50 text-primary-600 radius-8 px-12 py-6">@(exhibitionImageFile?.ContentType ?? "-")</span>
                                    </div>
                                    <div class="card-body">
                                        @if (exhibitionImageFile is null || string.IsNullOrWhiteSpace(exhibitionImagePreviewUrl))
                                        {
                                            <div class="alert alert-warning mb-0">@L[SubmissionManagementResourceKeys.FilesEmpty]</div>
                                        }
                                        else
                                        {
                                            <div class="border rounded-3 overflow-hidden bg-neutral-50">
                                                <div class="ratio ratio-16x9">
                                                    <img src="@exhibitionImagePreviewUrl" alt='@T("BackOffice.Submissions.Management.Editor.Exhibition.ImageAlt")' class="w-100 h-100 object-fit-cover" />
                                                </div>
                                            </div>
                                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-16">
                                                <div>
                                                    <h6 class="text-md mb-1">@exhibitionImageFile.OriginalFileName</h6>
                                                    <span class="text-sm text-neutral-500">@L[SubmissionManagementResourceKeys.UploadedAt]: @FormatDateTime(exhibitionImageFile.DisplayDate ?? exhibitionImageFile.UploadedAt)</span>
                                                </div>
                                                <div class="d-flex flex-wrap gap-2">
                                                    <button type="button" class="btn btn-outline-primary-600 radius-8 px-14 py-8 d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#exhibitionImagePreviewModal"><i class="ri-eye-line"></i> @T("BackOffice.Submissions.Management.Editor.Exhibition.Preview")</button>
                                                    <a href="@exhibitionImageDownloadUrl" class="btn btn-primary-600 radius-8 px-14 py-8 d-inline-flex align-items-center gap-1"><i class="ri-download-2-line"></i> @L[SubmissionManagementResourceKeys.Download]</a>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-5">
                                <div class="card border shadow-none radius-12 h-100">
                                    <div class="card-header border-bottom">
                                        <h6 class="text-md mb-1">@T("BackOffice.Submissions.Management.Editor.Exhibition.InfoTitle")</h6>
                                        <span class="text-sm text-neutral-500">@T("BackOffice.Submissions.Management.Editor.Exhibition.InfoDescription")</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex flex-column gap-3">
                                            @ExhibitionInfoItem("BackOffice.Submissions.Management.Editor.Exhibition.WorkName", detail.ExhibitionDetail?.WorkName ?? detail.Title)
                                            <div class="row gy-3">
                                                <div class="col-md-6">@ExhibitionInfoItem("BackOffice.Submissions.Management.Editor.Exhibition.Dimensions", detail.ExhibitionDetail?.Dimensions ?? "-")</div>
                                                <div class="col-md-6">@ExhibitionInfoItem("BackOffice.Submissions.Management.Editor.Exhibition.Technique", detail.ExhibitionDetail?.Technique ?? "-")</div>
                                            </div>
                                            @ExhibitionInfoItem("BackOffice.Submissions.Management.Editor.Exhibition.Address", detail.ExhibitionDetail?.Address ?? "-")
                                            <div class="border rounded-3 p-16 bg-neutral-50">
                                                <span class="text-sm text-neutral-500 d-block mb-6">@T("BackOffice.Submissions.Management.Editor.Exhibition.Description")</span>
                                                <div class="symplify-rich-content text-sm text-neutral-700 mb-0">@RenderRichText(detail.ExhibitionDetail?.Description ?? detail.Abstract, "-")</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @RenderAuthors(detail.Authors)
                        </div>
                    }
                    else
                    {
                        <div class="row gy-4">
                            <div class="col-12">
                                <div class="card border shadow-none radius-12 h-100">
                                    <div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                                        <div>
                                            <h6 class="text-md mb-1">@T("BackOffice.Submissions.Management.Editor.Content.Title")</h6>
                                            <span class="text-sm text-neutral-500">@T("BackOffice.Submissions.Management.Editor.Content.Description")</span>
                                        </div>
                                        <span class="badge bg-primary-50 text-primary-600 radius-8 px-12 py-6">@T("BackOffice.Submissions.Management.Editor.Content.LanguageBadge")</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="row gy-4">
                                            <div class="col-lg-6">
                                                <div class="border rounded-3 p-20 h-100">
                                                    <div class="d-flex align-items-center gap-2 mb-16"><span class="w-36-px h-36-px rounded-circle bg-primary-50 text-primary-600 d-flex align-items-center justify-content-center"><i class="ri-translate-2"></i></span><div><h6 class="text-md mb-0">@T("BackOffice.Submissions.Management.Editor.Content.Turkish")</h6><span class="text-sm text-neutral-500">@T("BackOffice.Submissions.Management.Editor.Content.DefaultLanguage")</span></div></div>
                                                    <span class="text-neutral-500 text-sm">@T("BackOffice.Submissions.Management.Editor.Content.TitleLabel")</span>
                                                    <h6 class="text-md mt-1 mb-12">@detail.Title</h6>
                                                    <span class="text-neutral-500 text-sm">@T("BackOffice.Submissions.Management.Editor.Content.AbstractLabel")</span>
                                                    <div class="symplify-rich-content text-sm text-neutral-700 mt-1 mb-12">@RenderRichText(detail.Abstract, "-")</div>
                                                    <span class="text-neutral-500 text-sm">@T("BackOffice.Submissions.Management.Editor.Content.KeywordsLabel")</span>
                                                    <div class="d-flex align-items-center flex-wrap gap-2 mt-2">@foreach (string keyword in SplitKeywords(detail.Keywords)){<span class="badge bg-primary-50 text-primary-600 radius-8 px-10 py-6">@keyword</span>}</div>
                                                </div>
                                            </div>
                                            <div class="col-lg-6">
                                                <div class="border rounded-3 p-20 h-100">
                                                    <div class="d-flex align-items-center gap-2 mb-16"><span class="w-36-px h-36-px rounded-circle bg-info-50 text-info-600 d-flex align-items-center justify-content-center"><i class="ri-translate"></i></span><div><h6 class="text-md mb-0">@T("BackOffice.Submissions.Management.Editor.Content.English")</h6><span class="text-sm text-neutral-500">@T("BackOffice.Submissions.Management.Editor.Content.TranslationFields")</span></div></div>
                                                    <span class="text-neutral-500 text-sm">@T("BackOffice.Submissions.Management.Editor.Content.TitleLabelEn")</span>
                                                    <h6 class="text-md mt-1 mb-12">@(string.IsNullOrWhiteSpace(detail.TitleEn) ? "-" : detail.TitleEn)</h6>
                                                    <span class="text-neutral-500 text-sm">@T("BackOffice.Submissions.Management.Editor.Content.AbstractLabelEn")</span>
                                                    <div class="symplify-rich-content text-sm text-neutral-700 mt-1 mb-12">@RenderRichText(detail.AbstractEn, "-")</div>
                                                    <span class="text-neutral-500 text-sm">@T("BackOffice.Submissions.Management.Editor.Content.KeywordsLabelEn")</span>
                                                    <div class="d-flex align-items-center flex-wrap gap-2 mt-2">@foreach (string keyword in SplitKeywords(detail.KeywordsEn)){<span class="badge bg-info-50 text-info-600 radius-8 px-10 py-6">@keyword</span>}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @RenderAuthors(detail.Authors)
                        </div>
                    }
                </div>

                @if (showReviewerAssignmentTab)
                {
                    <div class="tab-pane fade" id="reviewerTab" role="tabpanel" aria-labelledby="reviewer-tab" tabindex="0">
                        <div class="card border shadow-none radius-12">
                            <div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2"><div><h6 class="text-md mb-1">@L[SubmissionManagementResourceKeys.AssignedReviewersTitle]</h6><span class="text-sm text-neutral-500">@L[SubmissionManagementResourceKeys.AssignedReviewersDescription]</span></div><span class="badge bg-info-100 text-info-600 radius-8 px-12 py-6">@string.Format(T(SubmissionManagementResourceKeys.ReviewerCountFormat), reviewerCount)</span></div>
                            <div class="card-body">
                                @if (hasCompletedEvaluation) { <div class="alert alert-info bg-primary-50 border-primary-100 text-primary-700 mb-16">@L[SubmissionManagementResourceKeys.ReviewerAssignmentDisabledAfterEvaluation]</div> }
                                @if (!detail.Reviewers.Any()) { <div class="alert alert-warning mb-0">@L[SubmissionManagementResourceKeys.NoAssignedReviewers]</div> }
                                else
                                {
                                    <div class="row gy-3">
                                        @foreach (ManageSubmissionReviewerDto reviewer in detail.Reviewers)
                                        {
                                            <div class="col-lg-6"><div class="border rounded-3 p-18 h-100"><div class="d-flex align-items-start justify-content-between flex-wrap gap-2"><div><h6 class="text-md mb-1">@reviewer.FullName</h6><small class="text-neutral-500 d-block">@(reviewer.Institution ?? T(SubmissionManagementResourceKeys.InstitutionEmpty))</small><small class="text-neutral-500 d-block">@L[SubmissionManagementResourceKeys.AssignedAt]: @FormatDate(reviewer.AssignedAt)</small></div><span class="badge @(reviewer.Evaluation?.CompletedAt is not null ? "bg-success-100 text-success-600" : "bg-warning-100 text-warning-600") radius-8 px-10 py-6">@(reviewer.Evaluation?.CompletedAt is not null ? T(SubmissionManagementResourceKeys.ReviewCompleted) : T(SubmissionManagementResourceKeys.ReviewWaiting))</span></div></div></div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="tab-pane fade" id="reviewsTab" role="tabpanel" aria-labelledby="reviews-tab" tabindex="0">
                    <div class="card border shadow-none radius-12">
                        <div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                            <div>
                                <h6 class="text-md mb-1">@L[SubmissionManagementResourceKeys.EvaluationsInfoTitle]</h6>
                                <span class="text-sm text-neutral-500">@L[SubmissionManagementResourceKeys.EvaluationsInfoDescription]</span>
                            </div>
                            <span class="badge bg-neutral-100 text-neutral-700 radius-8 px-12 py-6">@string.Format(T("BackOffice.Submissions.Management.Editor.Evaluations.CountFormat"), detail.Evaluations.Count)</span>
                        </div>
                        <div class="card-body">
                            @if (!detail.Evaluations.Any())
                            {
                                <div class="alert alert-warning mb-3">@L[SubmissionManagementResourceKeys.EvaluationsEmpty]</div>
                                @if (canCreateEditorEvaluation)
                                {
                                    <a class="btn btn-success-600 radius-8 px-16 py-10 d-inline-flex align-items-center gap-2 d-print-none" href="@editorEvaluationUrl">
                                        <i class="ri-edit-2-line"></i>
                                        @L[SubmissionManagementResourceKeys.ActionEditorEvaluation]
                                    </a>
                                }
                            }
                            else
                            {
                                <div class="vstack gap-3">
                                    @foreach (ManageSubmissionEvaluationDto evaluation in detail.Evaluations)
                                    {
                                        <div class="border rounded-3 p-16">
                                            <div class="d-flex align-items-start justify-content-between gap-3 mb-3">
                                                <div>
                                                    <h6 class="text-md mb-1">@evaluation.ReviewerName</h6>
                                                    <small class="text-neutral-500">@L[SubmissionManagementResourceKeys.EvaluationDate]: @FormatDateTime(evaluation.CompletedAt ?? evaluation.CreatedDate)</small>
                                                </div>
                                                <div class="d-flex flex-wrap justify-content-end gap-2">
                                                    <span class="badge bg-primary-50 text-primary-600 radius-8 px-12 py-7">@(evaluation.Recommendation ?? T(SubmissionManagementResourceKeys.RecommendationEmpty))</span>
                                                    <span class="badge bg-success-50 text-success-600 radius-8 px-12 py-7">@string.Format(T("BackOffice.Submissions.Management.Editor.Evaluations.TotalScoreFormat"), evaluation.TotalScore?.ToString("0.##") ?? "-")</span>
                                                </div>
                                            </div>

                                            @if (evaluation.Scores.Any())
                                            {
                                                <div class="table-responsive mb-3">
                                                    <table class="table bordered-table mb-0">
                                                        <thead>
                                                            <tr>
                                                                <th>@L[SubmissionManagementResourceKeys.Criterion]</th>
                                                                <th class="text-end text-nowrap">@L[SubmissionManagementResourceKeys.Score]</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (ManageSubmissionEvaluationScoreDto score in evaluation.Scores)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        <span class="fw-semibold">@score.CriterionName</span>
                                                                        @if (!string.IsNullOrWhiteSpace(score.Comment))
                                                                        {
                                                                            <small class="text-neutral-500 d-block">@score.Comment</small>
                                                                        }
                                                                    </td>
                                                                    <td class="text-end fw-semibold">@score.Score.ToString("0.##")</td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-warning py-10 mb-3">@T("BackOffice.Submissions.Management.Editor.Evaluations.ScoreEmpty")</div>
                                            }

                                            <div>
                                                <span class="text-sm text-neutral-500 d-block mb-2 fw-semibold">@T("BackOffice.Submissions.Management.Editor.Evaluations.ReviewerComment")</span>
                                                <p class="mb-0 text-neutral-600">@(string.IsNullOrWhiteSpace(evaluation.Comment) ? T(SubmissionManagementResourceKeys.CommentEmpty) : evaluation.Comment)</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="filesTab" role="tabpanel" aria-labelledby="files-tab" tabindex="0">
                    <div class="card border shadow-none radius-12"><div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2"><div><h6 class="text-md mb-1">@L[SubmissionManagementResourceKeys.FilesTitle]</h6><span class="text-sm text-neutral-500">@L[SubmissionManagementResourceKeys.FilesDescription]</span></div><span class="badge bg-neutral-100 text-neutral-700 radius-8 px-12 py-6">@string.Format(T(SubmissionManagementResourceKeys.FilesCountFormat), detail.Files.Count)</span></div><div class="card-body">@if (!detail.Files.Any()){<div class="alert alert-warning mb-0">@L[SubmissionManagementResourceKeys.FilesEmpty]</div>}else{<div class="row gy-3">@foreach (ManageSubmissionFileDto file in detail.Files){string? downloadUrl = Url.Action("DownloadFile", "SubmissionManagementFiles", new { culture = currentCulture, fileId = file.Id }); string? previewUrl = IsImageFile(file) ? Url.Action("PreviewFile", "SubmissionManagementFiles", new { culture = currentCulture, fileId = file.Id }) : null;<div class="col-lg-6"><div class="border rounded-3 p-18 h-100"><div class="d-flex gap-3 align-items-start">@if (!string.IsNullOrWhiteSpace(previewUrl)){<div class="w-100-px flex-shrink-0"><div class="ratio ratio-1x1 border rounded-3 overflow-hidden bg-neutral-50"><img src="@previewUrl" alt="@file.OriginalFileName" class="w-100 h-100 object-fit-cover" /></div></div>}else{<span class="w-56-px h-56-px rounded-circle @(IsCertificateFile(file) ? "bg-success-50 text-success-600" : "bg-primary-50 text-primary-600") d-flex align-items-center justify-content-center flex-shrink-0"><i class="@(ResolveFileIcon(file)) text-xl"></i></span>}<div class="flex-grow-1"><div class="d-flex align-items-start justify-content-between gap-2"><div><h6 class="text-md mb-6">@file.OriginalFileName</h6><div class="d-flex flex-wrap gap-2 mb-6"><span class="badge @(IsCertificateFile(file) ? "bg-success-50 text-success-600" : "bg-primary-50 text-primary-600") radius-8 px-10 py-6">@ResolveFileKindLabel(file)</span><span class="badge bg-neutral-100 text-neutral-700 radius-8 px-10 py-6">@ResolveFileExtension(file)</span></div><span class="text-sm text-neutral-500 d-block">@L[SubmissionManagementResourceKeys.UploadedAt]: @FormatDateTime(file.DisplayDate ?? file.UploadedAt)</span></div><a href="@downloadUrl" class="btn btn-outline-primary-600 radius-8 px-14 py-8 d-inline-flex align-items-center gap-1"><i class="ri-download-2-line"></i> @L[SubmissionManagementResourceKeys.Download]</a></div></div></div></div></div>}</div>}</div></div>
                </div>

                <div class="tab-pane fade" id="historyTab" role="tabpanel" aria-labelledby="history-tab" tabindex="0">
                    <div class="card border shadow-none radius-12"><div class="card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2"><div><h6 class="text-md mb-1">@L[SubmissionManagementResourceKeys.HistoryTitle]</h6><span class="text-sm text-neutral-500">@L[SubmissionManagementResourceKeys.HistoryDescription]</span></div><span class="badge bg-primary-50 text-primary-600 radius-8 px-12 py-6">@string.Format(T(SubmissionManagementResourceKeys.HistoryCountFormat), detail.Histories.Count)</span></div><div class="card-body">@if (!detail.Histories.Any()){<div class="alert alert-warning mb-0">@L[SubmissionManagementResourceKeys.HistoryEmpty]</div>}else{<div class="d-flex flex-column gap-3">@foreach (ManageSubmissionHistoryDto history in detail.Histories){<div class="border rounded-3 p-18 d-flex align-items-start gap-3"><span class="w-40-px h-40-px rounded-circle @(history.IsAutomatic ? "bg-neutral-100 text-neutral-700" : "bg-primary-50 text-primary-600") d-flex align-items-center justify-content-center flex-shrink-0"><i class="ri-route-line"></i></span><div class="flex-grow-1"><div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-6"><h6 class="text-md mb-0">@ResolveHistoryTitle(history)</h6><span class="badge bg-neutral-100 text-neutral-700 radius-8 px-10 py-6">@FormatDateTime(history.PerformedAt)</span></div><p class="text-sm text-neutral-700 mb-1">@ResolveHistoryDescription(history)</p><small class="text-neutral-500">@L[SubmissionManagementResourceKeys.HistoryPerformedBy]: @history.PerformedByName</small></div></div>}</div>}</div></div>
                </div>
            </div>
        </div>
    </div>
</div>

