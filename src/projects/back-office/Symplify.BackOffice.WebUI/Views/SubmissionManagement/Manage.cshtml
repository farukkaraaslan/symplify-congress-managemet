@section Scripts {
    <script src="~/js/features/submissions/submissions-actions.js" asp-append-version="true"></script>
    <script>
        const reviewerRequiredMessage = '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(T(SubmissionManagementResourceKeys.ReviewerRequiredMessage))';
        document.querySelectorAll('.js-reviewer-assignment-form').forEach(function (form) {
            form.addEventListener('submit', function (event) {
                var select = form.querySelector('select[name="ReviewerId"]');
                if (!select || !select.value) {
                    event.preventDefault();
                    alert(reviewerRequiredMessage);
                }
            });
        });

        function activateSubmissionTabFromHash() {
            var hash = (window.location.hash || '').replace('#', '');
            if (!hash) return;

            if (hash === 'paymentActions') {
                var paymentActions = document.getElementById('paymentActions');
                if (paymentActions) paymentActions.scrollIntoView({ behavior: 'smooth', block: 'start' });
                return;
            }

            var tabMap = {
                summaryTab: 'summary-tab',
                reviewerTab: 'reviewer-tab',
                reviewsTab: 'reviews-tab',
                filesTab: 'files-tab',
                historyTab: 'history-tab'
            };

            var tabId = tabMap[hash] || hash;
            var tabButton = document.getElementById(tabId);
            if (!tabButton || !window.bootstrap) return;

            bootstrap.Tab.getOrCreateInstance(tabButton).show();
            var detailCard = document.getElementById('submissionDetailCard');
            if (detailCard) detailCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        document.querySelectorAll('[data-submission-tab-target]').forEach(function (button) {
            button.addEventListener('click', function () {
                var tabId = button.getAttribute('data-submission-tab-target');
                var tabButton = document.getElementById(tabId);
                if (!tabButton) return;
                bootstrap.Tab.getOrCreateInstance(tabButton).show();
                var detailCard = document.getElementById('submissionDetailCard');
                if (detailCard) detailCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        });

        activateSubmissionTabFromHash();
    </script>
}

@functions {
    private string T(string key) => L.GetStringValue(key);

    private static Microsoft.AspNetCore.Html.IHtmlContent RenderRichText(string? html, string fallback)
    {
        if (string.IsNullOrWhiteSpace(html))
            return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(fallback));

        return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlDecode(html));
    }
    private Microsoft.AspNetCore.Html.IHtmlContent TabButton(string id, string target, bool active, string icon, string titleKey, string subtitleKey)
    {
        string activeClass = active ? " active" : string.Empty;
        string selected = active ? "true" : "false";
        string html = $@"<li class=""nav-item"" role=""presentation""><button class=""nav-link{activeClass}"" id=""{id}"" data-bs-toggle=""tab"" data-bs-target=""#{target}"" type=""button"" role=""tab"" aria-controls=""{target}"" aria-selected=""{selected}""><span class=""d-flex align-items-center gap-2 fw-semibold""><i class=""{icon}""></i> {System.Net.WebUtility.HtmlEncode(T(titleKey))}</span><span class=""d-none d-lg-block text-sm text-neutral-500 mt-1"">{System.Net.WebUtility.HtmlEncode(T(subtitleKey))}</span></button></li>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    private string ResolveTransitionActionText(AllowedWorkflowTransitionDto transition)
    {
        string code = NormalizeCode(transition.ToStatusCode);
        if (IsCode(code, "ACCEPTED")) return T(SubmissionManagementResourceKeys.TransitionAccept);
        if (IsCode(code, "REJECTED")) return T(SubmissionManagementResourceKeys.TransitionReject);
        if (IsCode(code, "REVISION_REQUESTED")) return T(SubmissionManagementResourceKeys.TransitionRevision);
        if (IsCode(code, "REVIEWER_ASSIGNMENT", "UNDER_REVIEW")) return T(SubmissionManagementResourceKeys.TransitionSendToReview);
        if (IsCode(code, "PAYMENT_PENDING", "PAYMENT", "PAYMENT_DOCUMENT")) return T(SubmissionManagementResourceKeys.TransitionPayment);
        if (IsCode(code, "COMPLETED")) return T(SubmissionManagementResourceKeys.TransitionComplete);
        if (IsCode(code, "WITHDRAWN")) return T(SubmissionManagementResourceKeys.TransitionWithdraw);
        return string.IsNullOrWhiteSpace(transition.DisplayText) ? T(SubmissionManagementResourceKeys.TransitionDefault) : transition.DisplayText;
    }

    private string ResolveHistoryTitle(ManageSubmissionHistoryDto history)
    {
        string fromCode = NormalizeCode(history.FromStatusCode);
        string toCode = NormalizeCode(history.ToStatusCode);
        string sourceAction = NormalizeCode(history.SourceAction);
        string searchableText = string.Join(" ", new[] { history.Note, history.PublicNote, history.InternalNote }
            .Where(value => !string.IsNullOrWhiteSpace(value)));

        // Ödeme aksiyonları workflow statüsünü değiştirmediği için önce bunlar çözülmelidir.
        if (sourceAction == "PAYMENTCOMPLETED" ||
            (ContainsHistoryText(searchableText, "ödeme") &&
             ContainsAnyHistoryText(searchableText, "tamamlandı", "onaylandı", "işlemi yapıldı")))
        {
            return T(SubmissionManagementResourceKeys.HistoryPaymentCompletedTitle);
        }

        if (sourceAction == "PAYMENTREVERTED" ||
            (ContainsHistoryText(searchableText, "ödeme") &&
             ContainsAnyHistoryText(searchableText, "geri alındı", "yeniden bekleniyor")))
        {
            return T(SubmissionManagementResourceKeys.HistoryPaymentRevertedTitle);
        }

        if (ContainsAnyHistoryText(searchableText, "hakem atandı", "reviewer assigned"))
            return T(SubmissionManagementResourceKeys.HistoryReviewerAssignedTitle);

        if (ContainsAnyHistoryText(
                searchableText,
                "hakem değerlendirmesi tamamlandı",
                "editör değerlendirmesi tamamlandı",
                "reviewer evaluation completed",
                "editor evaluation completed"))
        {
            return T(SubmissionManagementResourceKeys.HistoryReviewCompletedTitle);
        }

        string? statusResourceKey = toCode switch
        {
            "DRAFT" => SubmissionManagementResourceKeys.HistoryDraftTitle,
            "SUBMITTED" => SubmissionManagementResourceKeys.HistorySubmittedTitle,
            "REVIEWER_ASSIGNMENT" => SubmissionManagementResourceKeys.HistoryReviewAssignmentTitle,
            "UNDER_REVIEW" => SubmissionManagementResourceKeys.HistoryReviewStartedTitle,
            "EDITOR_EVALUATION" or "EDITORIAL_REVIEW" or "DECISION_PENDING" => SubmissionManagementResourceKeys.HistoryEditorialDecisionTitle,
            "ACCEPTED" => SubmissionManagementResourceKeys.HistoryAcceptedTitle,
            "PAYMENT_PENDING" or "PAYMENT" or "PAYMENT_DOCUMENT" => SubmissionManagementResourceKeys.HistoryPaymentTitle,
            "COMPLETED" => SubmissionManagementResourceKeys.HistoryCompletedTitle,
            "REJECTED" => SubmissionManagementResourceKeys.HistoryRejectedTitle,
            "WITHDRAWN" => SubmissionManagementResourceKeys.HistoryWithdrawnTitle,
            _ => null
        };

        if (!string.IsNullOrWhiteSpace(statusResourceKey))
            return T(statusResourceKey);

        bool hasFrom = !string.IsNullOrWhiteSpace(history.FromStatusName) && history.FromStatusName != "-";
        bool hasTo = !string.IsNullOrWhiteSpace(history.ToStatusName) && history.ToStatusName != "-";
        bool isRealStatusTransition = !string.IsNullOrWhiteSpace(fromCode)
            && !string.IsNullOrWhiteSpace(toCode)
            && !string.Equals(fromCode, toCode, StringComparison.OrdinalIgnoreCase);

        if (isRealStatusTransition && hasFrom && hasTo)
            return $"{history.FromStatusName} → {history.ToStatusName}";

        if (hasTo && string.IsNullOrWhiteSpace(fromCode))
            return history.ToStatusName;

        return T(SubmissionManagementResourceKeys.HistoryGenericTitle);
    }

    private string ResolveHistoryDescription(ManageSubmissionHistoryDto history)
    {
        string? note = !string.IsNullOrWhiteSpace(history.PublicNote)
            ? history.PublicNote
            : !string.IsNullOrWhiteSpace(history.Note)
                ? history.Note
                : history.InternalNote;

        return string.IsNullOrWhiteSpace(note) ? T(SubmissionManagementResourceKeys.HistoryNoNote) : note;
    }

    private static bool ContainsHistoryText(string source, string value)
    {
        return !string.IsNullOrWhiteSpace(source)
            && source.Contains(value, StringComparison.OrdinalIgnoreCase);
    }

    private static bool ContainsAnyHistoryText(string source, params string[] values)
    {
        return values.Any(value => ContainsHistoryText(source, value));
    }

    private static string DisplayAuthorName(ManageSubmissionAuthorDto author)
    {
        string title = string.IsNullOrWhiteSpace(author.TitleName) ? string.Empty : author.TitleName.Trim();
        string name = string.IsNullOrWhiteSpace(author.FullName) ? "-" : author.FullName.Trim();
        return string.IsNullOrWhiteSpace(title) ? name : $"{title} {name}";
    }

    private static bool IsPaidPaymentStatusName(string? value)
    {
        string normalized = NormalizeCode(value);
        if (string.IsNullOrWhiteSpace(normalized)) return false;
        if (normalized.Contains("BEKLIYOR", StringComparison.Ordinal) || normalized.Contains("PENDING", StringComparison.Ordinal)) return false;
        return normalized.Contains("ODENDI", StringComparison.Ordinal) ||
               normalized.Contains("ODEMEISLEMIYAPILDI", StringComparison.Ordinal) ||
               normalized.Contains("ODEMEYAPILDI", StringComparison.Ordinal) ||
               normalized.Contains("PAID", StringComparison.Ordinal) ||
               normalized.Contains("COMPLETED", StringComparison.Ordinal) ||
               normalized.Contains("APPROVED", StringComparison.Ordinal);
    }

    private static string NormalizeCode(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return string.Empty;
        return value.Trim().Replace("-", "_").Replace(" ", "_").ToUpperInvariant();
    }

    private static bool IsCode(string value, params string[] expected) => expected.Any(item => value.Equals(item, StringComparison.OrdinalIgnoreCase));

    private static IEnumerable<string> SplitKeywords(string? keywords)
    {
        if (string.IsNullOrWhiteSpace(keywords)) return Array.Empty<string>();
        return keywords.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Where(item => !string.IsNullOrWhiteSpace(item));
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "?";
        string[] parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant();
        return string.Concat(parts.Take(2).Select(part => part[0])).ToUpperInvariant();
    }



    private Microsoft.AspNetCore.Html.IHtmlContent ExhibitionInfoItem(string labelKey, string? value)
    {
        string html = $@"<div class=""border rounded-3 p-16 h-100""><span class=""text-sm text-neutral-500"">{System.Net.WebUtility.HtmlEncode(T(labelKey))}</span><h6 class=""text-md mb-0 mt-1"">{System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(value) ? "-" : value)}</h6></div>";
        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }

    private Microsoft.AspNetCore.Html.IHtmlContent RenderAuthors(IEnumerable<ManageSubmissionAuthorDto> authors)
    {
        var list = authors?.ToList() ?? new List<ManageSubmissionAuthorDto>();
        var builder = new System.Text.StringBuilder();

        builder.Append("<div class=\"col-12\"><div class=\"card border shadow-none radius-12\">");
        builder.Append("<div class=\"card-header border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2\"><div>");
        builder.Append($"<h6 class=\"text-md mb-1\">{System.Net.WebUtility.HtmlEncode(T(SubmissionManagementResourceKeys.AuthorsTitle))}</h6>");
        builder.Append($"<span class=\"text-sm text-neutral-500\">{System.Net.WebUtility.HtmlEncode(T(SubmissionManagementResourceKeys.AuthorsDescription))}</span>");
        builder.Append("</div>");
        builder.Append($"<span class=\"badge bg-neutral-100 text-neutral-700 radius-8 px-12 py-6\">{System.Net.WebUtility.HtmlEncode(string.Format(T(SubmissionManagementResourceKeys.AuthorCountFormat), list.Count))}</span>");
        builder.Append("</div><div class=\"card-body\">");

        if (!list.Any())
        {
            builder.Append($"<div class=\"alert alert-warning mb-0\">{System.Net.WebUtility.HtmlEncode(T(SubmissionManagementResourceKeys.AuthorsEmpty))}</div>");
        }
        else
        {
            builder.Append("<div class=\"row gy-3\">");
            foreach (ManageSubmissionAuthorDto author in list)
            {
                string cardClass = author.IsCorrespondingAuthor
                    ? "border rounded-3 p-18 bg-success-50 border-success-200 h-100"
                    : "border rounded-3 p-18 h-100";
                string dotClass = author.IsCorrespondingAuthor ? "bg-success-600" : "bg-neutral-400";
                string badgeClass = author.IsCorrespondingAuthor
                    ? "bg-success-100 text-success-700"
                    : "bg-neutral-100 text-neutral-700";
                string role = author.IsCorrespondingAuthor
                    ? T(SubmissionManagementResourceKeys.AuthorBadgeCorresponding)
                    : T(SubmissionManagementResourceKeys.AuthorBadgeCoAuthor);
                string email = string.IsNullOrWhiteSpace(author.Email) ? "-" : author.Email.Trim();
                string institution = string.IsNullOrWhiteSpace(author.Institution) ? "-" : author.Institution.Trim();
                string orcid = string.IsNullOrWhiteSpace(author.Orcid) ? "-" : author.Orcid.Trim();
                string mailHref = email == "-" ? "#" : $"mailto:{Uri.EscapeDataString(email)}";

                builder.Append("<div class=\"col-lg-6\"><div class=\"").Append(cardClass).Append("\"><div class=\"d-flex align-items-start justify-content-between flex-wrap gap-2\"><div>");
                builder.Append("<div class=\"d-flex align-items-center flex-wrap gap-2 mb-10\">");
                builder.Append($"<span class=\"w-10-px h-10-px rounded-circle {dotClass}\"></span>");
                builder.Append($"<h6 class=\"text-md mb-0\">{System.Net.WebUtility.HtmlEncode(DisplayAuthorName(author))}</h6>");
                builder.Append($"<span class=\"badge {badgeClass} radius-8 px-10 py-6\">{System.Net.WebUtility.HtmlEncode(role)}</span>");
                builder.Append("</div><div class=\"d-flex flex-column gap-1 text-sm text-neutral-700\">");
                builder.Append($"<span>{System.Net.WebUtility.HtmlEncode(T("BackOffice.Submissions.Management.Editor.Author.Email"))}: {System.Net.WebUtility.HtmlEncode(email)}</span>");
                builder.Append($"<span>{System.Net.WebUtility.HtmlEncode(T("BackOffice.Submissions.Management.Editor.Author.Institution"))}: {System.Net.WebUtility.HtmlEncode(institution)}</span>");
                builder.Append($"<span>{System.Net.WebUtility.HtmlEncode(T("BackOffice.Submissions.Management.Editor.Author.Orcid"))}: {System.Net.WebUtility.HtmlEncode(orcid)}</span>");
                builder.Append("</div></div>");
                if (email != "-")
                {
                    builder.Append($"<a href=\"{mailHref}\" class=\"btn btn-light-100 text-dark radius-8 px-14 py-8\">{System.Net.WebUtility.HtmlEncode(T("BackOffice.Submissions.Management.Editor.Author.Contact"))}</a>");
                }
                builder.Append("</div></div></div>");
            }
            builder.Append("</div>");
        }

        builder.Append("</div></div></div>");
        return new Microsoft.AspNetCore.Html.HtmlString(builder.ToString());
    }

    private static bool IsImageFile(ManageSubmissionFileDto file)
        => !string.IsNullOrWhiteSpace(file.ContentType) && file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static bool IsCertificateFile(ManageSubmissionFileDto file)
        => file.IsAcceptanceLetter ||
           string.Equals(file.FileKind, "ParticipationCertificate", StringComparison.OrdinalIgnoreCase);

    private static string ResolveFileIcon(ManageSubmissionFileDto file)
    {
        if (string.Equals(file.FileKind, "ParticipationCertificate", StringComparison.OrdinalIgnoreCase))
            return "ri-award-line";

        return file.IsAcceptanceLetter ? "ri-file-shield-2-line" : "ri-file-text-line";
    }

    private string ResolveFileKindLabel(ManageSubmissionFileDto file)
    {
        if (string.Equals(file.FileKind, "ExhibitionImage", StringComparison.OrdinalIgnoreCase))
            return T("BackOffice.Submissions.Management.Editor.Files.Kind.ExhibitionImage");

        if (string.Equals(file.FileKind, "ParticipationCertificate", StringComparison.OrdinalIgnoreCase))
            return T("BackOffice.Submissions.Management.Editor.Files.Kind.ParticipationCertificate");

        if (file.IsAcceptanceLetter)
            return T("BackOffice.Submissions.Management.Editor.Files.Kind.AcceptanceLetter");

        return string.IsNullOrWhiteSpace(file.DisplayKind)
            ? T("BackOffice.Submissions.Management.Editor.Files.Kind.Other")
            : file.DisplayKind;
    }

    private static string ResolveFileExtension(ManageSubmissionFileDto file)
    {
        string? extension = System.IO.Path.GetExtension(file.OriginalFileName);
        if (!string.IsNullOrWhiteSpace(extension))
            return extension.TrimStart('.').ToUpperInvariant();

        if (!string.IsNullOrWhiteSpace(file.ContentType) && file.ContentType.Contains('/'))
            return file.ContentType[(file.ContentType.LastIndexOf('/') + 1)..].ToUpperInvariant();

        return "FILE";
    }

    private static string FormatDate(DateTime? value) => IsMeaningfulDate(value) ? value!.Value.ToString("dd.MM.yyyy") : "-";
    private static string FormatDateTime(DateTime? value) => IsMeaningfulDate(value) ? value!.Value.ToString("dd.MM.yyyy HH:mm") : "-";
    private static bool IsMeaningfulDate(DateTime? value) => value.HasValue && value.Value.Year >= 1900;

    private static string FormatBytes(long? bytes)
    {
        if (!bytes.HasValue || bytes.Value <= 0) return "-";
        double value = bytes.Value;
        string[] units = { "B", "KB", "MB", "GB" };
        int unitIndex = 0;
        while (value >= 1024 && unitIndex < units.Length - 1) { value /= 1024; unitIndex++; }
        return $"{value:0.#} {units[unitIndex]}";
    }
}
