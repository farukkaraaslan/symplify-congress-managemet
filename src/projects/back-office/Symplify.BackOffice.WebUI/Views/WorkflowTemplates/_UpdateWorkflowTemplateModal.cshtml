@model Symplify.BackOffice.WebUI.Models.WorkflowTemplates.UpdateWorkflowTemplateViewModel
@inject Symplify.BackOffice.WebUI.Localization.IBackOfficeViewLocalizer L
@using Symplify.BackOffice.WebUI.Models.WorkflowTemplates
@{
    string currentCulture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    var initialStatuses = ViewData["InitialStatuses"] as List<TransactionStatusSelectItemViewModel> ?? new();
    string defaultLanguageLabel = L.GetStringValue("Common.Default");
    if (string.IsNullOrWhiteSpace(defaultLanguageLabel) || string.Equals(defaultLanguageLabel, "Common.Default", StringComparison.OrdinalIgnoreCase))
    {
        defaultLanguageLabel = "Varsayılan";
    }
}

<div class="modal fade" id="updateWorkflowTemplateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content radius-16">
            <form id="updateWorkflowTemplateForm"
                  asp-controller="WorkflowTemplates"
                  asp-action="Update"
                  asp-route-culture="@currentCulture"
                  method="post"
                  data-feature="workflow-templates">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div class="modal-header border-bottom">
                    <div>
                        <h6 class="modal-title">@L["BackOffice.WorkflowTemplates.UpdateTitle"]</h6>
                        <small class="text-neutral-500 d-block mt-1">
                            @L["BackOffice.WorkflowTemplates.PageDescription"]
                        </small>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
                </div>

                <div class="modal-body">
                    <div class="alert alert-danger d-none js-validation-summary" role="alert"></div>

                    <div class="card border shadow-none mb-4">
                        <div class="card-header border-bottom">
                            <h6 class="text-md mb-0">@L["Common.Translations"]</h6>
                        </div>

                        <div class="card-body">
                            <ul class="nav nav-pills mb-3" role="tablist">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    string tabId = "updateWorkflowTemplateTranslationTab-" + i;
                                    string paneId = "updateWorkflowTemplateTranslationPane-" + i;

                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(i == 0 ? "active" : string.Empty)"
                                                id="@tabId"
                                                data-bs-toggle="pill"
                                                data-bs-target="#@paneId"
                                                type="button"
                                                role="tab"
                                                aria-controls="@paneId"
                                                aria-selected="@(i == 0 ? "true" : "false")">
                                            @Model.Translations[i].LanguageName
                                            @if (Model.Translations[i].IsDefault)
                                            {
                                                <span class="badge bg-primary-50 text-primary-600 ms-1">@defaultLanguageLabel</span>
                                            }
                                        </button>
                                    </li>
                                }
                            </ul>

                            <div class="tab-content">
                                @for (int i = 0; i < Model.Translations.Count; i++)
                                {
                                    string tabId = "updateWorkflowTemplateTranslationTab-" + i;
                                    string paneId = "updateWorkflowTemplateTranslationPane-" + i;
                                    bool isDefaultLanguage = Model.Translations[i].IsDefault;

                                    <div class="tab-pane fade @(i == 0 ? "show active" : string.Empty)"
                                         id="@paneId"
                                         role="tabpanel"
                                         aria-labelledby="@tabId"
                                         tabindex="0">
                                        <input type="hidden" asp-for="Translations[i].LanguageId" />
                                        <input type="hidden" asp-for="Translations[i].Culture" />
                                        <input type="hidden" asp-for="Translations[i].LanguageName" />
                                        <input type="hidden" asp-for="Translations[i].IsDefault" />
                                        <input type="hidden" asp-for="Translations[i].Exists" />

                                        <div class="row gy-4">
                                            <div class="col-12">
                                                <label class="form-label" asp-for="Translations[i].Name">
                                                    @L["Common.Name"]
                                                    <required-mark visible="@isDefaultLanguage"></required-mark>
                                                </label>
                                                <input asp-for="Translations[i].Name"
                                                       class="form-control"
                                                       autocomplete="off"
                                                       data-val="@isDefaultLanguage.ToString().ToLowerInvariant()"
                                                       data-val-required="@(isDefaultLanguage ? L.GetStringValue("BackOffice.WorkflowTemplates.Validation.NameRequired") : null)" />
                                                <span asp-validation-for="Translations[i].Name" class="text-danger small d-block mt-1"></span>
                                            </div>

                                            <div class="col-12">
                                                <label class="form-label" asp-for="Translations[i].Description">
                                                    @L["Common.Description"]
                                                </label>
                                                <textarea asp-for="Translations[i].Description" class="form-control" rows="4"></textarea>
                                                <span asp-validation-for="Translations[i].Description" class="text-danger small d-block mt-1"></span>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card border shadow-none">
                        <div class="card-header border-bottom">
                            <h6 class="text-md mb-0">@L["Common.BasicInformation"]</h6>
                        </div>

                        <div class="card-body">
                            <div class="row gy-4">
                                <div class="col-md-6">
                                    <label class="form-label" asp-for="Code">
                                        @L["Common.Code"] <required-mark></required-mark>
                                    </label>
                                    <input asp-for="Code"
                                           class="form-control"
                                           autocomplete="off"
                                           data-val="true"
                                           data-val-required="@L.GetStringValue("BackOffice.WorkflowTemplates.Validation.CodeRequired")" />
                                    <span asp-validation-for="Code" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" asp-for="InitialTransactionStatusId">
                                        @L["BackOffice.WorkflowTemplates.InitialTransactionStatus"]
                                    </label>
                                    <select asp-for="InitialTransactionStatusId" class="form-select">
                                        <option value="">@L["Common.SelectPlease"]</option>
                                        @foreach (TransactionStatusSelectItemViewModel item in initialStatuses)
                                        {
                                            <option value="@item.Id">@item.DisplayText</option>
                                        }
                                    </select>
                                    <span asp-validation-for="InitialTransactionStatusId" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label d-block" asp-for="IsDefault">
                                        @L["BackOffice.WorkflowTemplates.IsDefault"]
                                    </label>
                                    <div class="form-switch switch-primary d-flex align-items-center gap-3">
                                        <input asp-for="IsDefault"
                                               id="updateWorkflowTemplateIsDefault"
                                               class="form-check-input"
                                               type="checkbox"
                                               role="switch" />
                                        <label class="form-check-label" for="updateWorkflowTemplateIsDefault">
                                            @L["BackOffice.WorkflowTemplates.IsDefault"]
                                        </label>
                                    </div>
                                    <span asp-validation-for="IsDefault" class="text-danger small d-block mt-1"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label d-block" asp-for="IsActive">
                                        @L["Common.Status"] <required-mark></required-mark>
                                    </label>
                                    <div class="form-switch switch-primary d-flex align-items-center gap-3">
                                        <input asp-for="IsActive"
                                               id="updateWorkflowTemplateIsActive"
                                               class="form-check-input js-lookup-status-switch js-workflow-template-status-switch"
                                               type="checkbox"
                                               role="switch" />
                                        <label class="form-check-label js-lookup-status-label js-workflow-template-status-label text-success-600 fw-medium"
                                               for="updateWorkflowTemplateIsActive">
                                            @L["Common.Active"]
                                        </label>
                                    </div>
                                    <span asp-validation-for="IsActive" class="text-danger small d-block mt-1"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-neutral-900 radius-8 px-20 py-11" data-bs-dismiss="modal">
                        @L["Common.Cancel"]
                    </button>
                    <button type="submit" class="btn btn-primary-600 radius-8 px-20 py-11 d-inline-flex align-items-center gap-2">
                        <i class="ri-save-line"></i>
                        @L["Common.Save"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
