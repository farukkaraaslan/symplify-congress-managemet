@model Symplify.BackOffice.WebUI.Models.OrganizationMailConfigurations.OrganizationMailConfigurationsIndexViewModel
@inject Symplify.BackOffice.WebUI.Localization.IBackOfficeViewLocalizer L

@{
    ViewData["Title"] = "Mail Ayarları";
    string culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    string indexUrl = Url.Action("Index", "OrganizationMailConfigurations", new { culture })
        ?? $"/{culture}/OrganizationMailConfigurations/Index";
    string saveUrl = Url.Action("Save", "OrganizationMailConfigurations", new { culture })
        ?? $"/{culture}/OrganizationMailConfigurations/Save";
    string testUrl = Url.Action("SendTest", "OrganizationMailConfigurations", new { culture })
        ?? $"/{culture}/OrganizationMailConfigurations/SendTest";
    string deleteUrl = Url.Action("Delete", "OrganizationMailConfigurations", new { culture })
        ?? $"/{culture}/OrganizationMailConfigurations/Delete";
    string? logoUrl = Model.SelectedOrganizationId.HasValue && Model.HasMailLogo
        ? Url.Action("Logo", "OrganizationMailConfigurations", new
        {
            culture,
            organizationId = Model.SelectedOrganizationId.Value
        })
        : null;
}

<div class="dashboard-main-body">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
        <div>
            <h6 class="fw-semibold mb-0">Organizasyon Mail Ayarları</h6>
            <small class="text-neutral-500">
                Her organizasyonun tüm kayıt, doğrulama, şifre sıfırlama, bildiri, ödeme, belge ve toplu mail gönderimlerini tek noktadan yönetin.
            </small>
        </div>

        <ul class="d-flex align-items-center gap-2 mb-0">
            <li class="fw-medium">
                <a href="@Url.Action("Index", "Home", new { culture })"
                   class="d-flex align-items-center gap-1 hover-text-primary text-neutral-600">
                    <iconify-icon icon="solar:home-smile-angle-outline"
                                  class="icon text-lg"></iconify-icon>
                    Panel
                </a>
            </li>
            <li>-</li>
            <li class="fw-medium">Organizasyon Yönetimi</li>
            <li>-</li>
            <li class="fw-medium">Mail Ayarları</li>
        </ul>
    </div>

    <div class="alert alert-info bg-primary-50 border-primary-100 text-primary-700 d-flex align-items-start gap-3 mb-24">
        <i class="ri-information-line text-xl mt-1"></i>
        <div>
            <h6 class="text-md mb-1">Organizasyon mail yönetimi</h6>
            <p class="mb-0">
                Seçili organizasyonun SMTP hesabını, gönderici bilgilerini, yanıt adresini ve private MinIO üzerinde tutulan mail logosunu bu ekrandan yönetin.
            </p>
        </div>
    </div>

    <div class="card border shadow-none radius-12 mb-24">
    <div class="card-header bg-base py-16 px-24 border-bottom">
        <div class="row align-items-end gy-3">
            <div class="col-lg-6">
                <label for="organizationMailSelector" class="form-label fw-semibold">Organizasyon</label>
                <select id="organizationMailSelector"
                        class="form-select radius-8"
                        data-index-url="@indexUrl">
                    @if (Model.Organizations.Count == 0)
                    {
                        <option value="">Aktif organizasyon bulunamadı</option>
                    }
                    else
                    {
                        @foreach (var option in Model.Organizations)
                        {
                            <option value="@option.Value" selected="@(option.Selected ? "selected" : null)">@option.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-lg-6">
                @if (Model.SelectedOrganizationId.HasValue)
                {
                    <div class="d-flex flex-wrap justify-content-lg-end align-items-center gap-2">
                        <span class="badge bg-primary-50 text-primary-600 px-12 py-8 radius-8">
                            @(Model.SelectedOrganizationCode ?? "Organizasyon")
                        </span>
                        <span class="text-sm text-neutral-600">@Model.SelectedOrganizationName</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card-body p-24">
        @if (!Model.SelectedOrganizationId.HasValue)
        {
            <div class="alert alert-warning mb-0">
                Mail ayarı oluşturabilmek için önce aktif bir organizasyon oluşturmalısınız.
            </div>
        }
        else
        {
            <div id="organizationMailConfigurationRoot"
                 data-organization-id="@Model.SelectedOrganizationId"
                 data-save-url="@saveUrl"
                 data-test-url="@testUrl"
                 data-delete-url="@deleteUrl">

                <div class="alert alert-info bg-info-50 border-info-100 text-info-700 mb-24">
                    Bu organizasyona bağlı tüm kongreler ve kullanıcı işlemleri aynı SMTP ayarını kullanır.
                    Kayıt doğrulama, şifre sıfırlama, bildiri, hakem, ödeme, kabul, katılım belgesi ve toplu e-posta gönderimleri burada tanımlanan adresten çıkar.
                </div>

                <form id="organizationMailConfigurationForm" class="row gy-3" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrganizationId" value="@Model.Configuration.OrganizationId" />

                    <div class="col-lg-8">
                        <label class="form-label fw-semibold">SMTP Sunucusu</label>
                        <input class="form-control radius-8"
                               name="Host"
                               maxlength="250"
                               autocomplete="off"
                               value="@Model.Configuration.Host"
                               placeholder="email-smtp.eu-central-1.amazonaws.com"
                               required />
                    </div>

                    <div class="col-lg-2 col-md-6">
                        <label class="form-label fw-semibold">Port</label>
                        <input class="form-control radius-8"
                               name="Port"
                               type="number"
                               min="1"
                               max="65535"
                               value="@Model.Configuration.Port"
                               required />
                    </div>

                    <div class="col-lg-2 col-md-6 d-flex align-items-end">
                        <div class="form-switch switch-primary d-flex align-items-center gap-3 mb-10">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="mailEnableSsl"
                                   name="EnableSsl"
                                   value="true"
                                   checked="@(Model.Configuration.EnableSsl ? "checked" : null)" />
                            <label class="form-check-label" for="mailEnableSsl">SSL/TLS</label>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <label class="form-label fw-semibold">SMTP Kullanıcı Adı</label>
                        <input class="form-control radius-8"
                               name="Username"
                               maxlength="250"
                               autocomplete="off"
                               value="@Model.Configuration.Username"
                               required />
                    </div>

                    <div class="col-lg-6">
                        <label class="form-label fw-semibold">SMTP Parolası</label>
                        <input class="form-control radius-8"
                               name="Password"
                               type="password"
                               maxlength="500"
                               autocomplete="new-password" />
                        <small id="mailPasswordHint" class="text-neutral-500">
                            @(Model.HasStoredPassword
                                ? "Kayıtlı parola vardır. Değiştirmek istemiyorsanız alanı boş bırakın."
                                : "İlk kayıtta SMTP parolası zorunludur.")
                        </small>
                    </div>

                    <div class="col-lg-6">
                        <label class="form-label fw-semibold">Gönderici E-posta</label>
                        <input class="form-control radius-8"
                               name="FromEmail"
                               type="email"
                               maxlength="250"
                               value="@Model.Configuration.FromEmail"
                               placeholder="noreply@organizasyon-domain.com"
                               required />
                    </div>

                    <div class="col-lg-6">
                        <label class="form-label fw-semibold">Gönderici Adı</label>
                        <input class="form-control radius-8"
                               name="FromName"
                               maxlength="250"
                               value="@Model.Configuration.FromName"
                               placeholder="Organizasyon Adı"
                               required />
                    </div>

                    <div class="col-lg-6">
                        <label class="form-label fw-semibold">Yanıt E-posta (Reply-To)</label>
                        <input class="form-control radius-8"
                               name="ReplyToEmail"
                               type="email"
                               maxlength="250"
                               value="@Model.Configuration.ReplyToEmail"
                               placeholder="info@organizasyon-domain.com" />
                    </div>

                    <div class="col-lg-6">
                        <label class="form-label fw-semibold">Yanıt Adı</label>
                        <input class="form-control radius-8"
                               name="ReplyToName"
                               maxlength="250"
                               value="@Model.Configuration.ReplyToName"
                               placeholder="Organizasyon Destek" />
                    </div>

                    <div class="col-12 mt-8">
                        <label class="form-label fw-semibold">Mail Logosu</label>
                        <div class="border rounded-3 p-16 bg-neutral-50 d-flex flex-wrap align-items-center gap-4">
                            <div id="organizationMailLogoPreviewContainer"
                                 class="bg-white border rounded-3 d-flex align-items-center justify-content-center p-12"
                                 style="width:220px;min-height:110px;">
                                @if (!string.IsNullOrWhiteSpace(logoUrl))
                                {
                                    <img id="organizationMailLogoPreview"
                                         src="@logoUrl"
                                         alt="@(Model.SelectedOrganizationName ?? "Organizasyon mail logosu")"
                                         style="display:block;max-width:190px;max-height:86px;width:auto;height:auto;" />
                                }
                                else
                                {
                                    <div id="organizationMailLogoEmptyState" class="text-center text-neutral-500 text-sm">
                                        <i class="ri-image-line d-block text-xl mb-1"></i>
                                        Mail logosu yüklenmedi
                                    </div>
                                }
                            </div>

                            <div class="flex-grow-1" style="min-width:280px;">
                                <input class="form-control radius-8"
                                       type="file"
                                       id="organizationMailLogoInput"
                                       name="MailLogo"
                                       accept=".png,.jpg,.jpeg,image/png,image/jpeg" />
                                <small class="text-neutral-500 d-block mt-2">
                                    PNG veya JPEG, en fazla 300 KB. Görsel private MinIO'da tutulur ve mail içine CID olarak gömülür; public URL oluşturulmaz.
                                </small>
                                @if (Model.HasMailLogo)
                                {
                                    <div class="form-check mt-3">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="removeOrganizationMailLogo"
                                               name="RemoveMailLogo"
                                               value="true" />
                                        <label class="form-check-label" for="removeOrganizationMailLogo">
                                            Mevcut mail logosunu kaldır
                                            @if (!string.IsNullOrWhiteSpace(Model.MailLogoFileName))
                                            {
                                                <span class="text-neutral-500">(@Model.MailLogoFileName)</span>
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="col-12 d-flex flex-wrap align-items-center justify-content-between gap-3 mt-20">
                        <div class="form-switch switch-primary d-flex align-items-center gap-3">
                            <input class="form-check-input"
                                   type="checkbox"
                                   role="switch"
                                   id="mailIsActive"
                                   name="IsActive"
                                   value="true"
                                   checked="@(Model.Configuration.IsActive ? "checked" : null)" />
                            <label class="form-check-label" for="mailIsActive">Mail ayarları aktif</label>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="button"
                                    id="deleteOrganizationMailConfigurationButton"
                                    class="btn btn-outline-danger radius-8 px-16 py-8 @(Model.Exists ? string.Empty : "d-none")">
                                <i class="ri-delete-bin-line me-1"></i> Ayarları Kaldır
                            </button>
                            <button type="submit" class="btn btn-primary-600 radius-8 px-20 py-8">
                                <i class="ri-save-line me-1"></i> Kaydet
                            </button>
                        </div>
                    </div>
                </form>

                <hr class="my-24" />

                <form id="organizationMailTestForm" class="row gy-3 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrganizationId" value="@Model.Configuration.OrganizationId" />
                    <div class="col-lg-6">
                        <label class="form-label fw-semibold">Test Alıcı E-posta</label>
                        <input class="form-control radius-8"
                               name="ToEmail"
                               type="email"
                               maxlength="250"
                               required />
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label fw-semibold">Test Alıcı Adı</label>
                        <input class="form-control radius-8" name="ToName" maxlength="250" />
                    </div>
                    <div class="col-lg-2">
                        <button type="submit" class="btn btn-outline-primary-600 radius-8 w-100 px-16 py-10">
                            <i class="ri-send-plane-line me-1"></i> Test Gönder
                        </button>
                    </div>
                </form>

                <div id="organizationMailTestStatus" class="mt-16">
                    @if (Model.LastTestedAt.HasValue)
                    {
                        <div class="alert @(Model.LastTestSucceeded == true ? "alert-success" : "alert-danger") mb-0">
                            @if (Model.LastTestSucceeded == true)
                            {
                                <span>Son test başarılı. @Model.LastTestedAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span>Son test başarısız: @(Model.LastTestError ?? "Bilinmeyen hata")</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

</div>

@section Scripts {
    <script src="~/js/features/organization-mail-configurations/organization-mail-configurations.index.js" asp-append-version="true"></script>
}
