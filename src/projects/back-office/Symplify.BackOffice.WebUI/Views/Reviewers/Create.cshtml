@model Symplify.BackOffice.Application.Features.Reviewers.Commands.Create.CreateReviewerCommand
@inject Symplify.BackOffice.WebUI.Localization.IBackOfficeViewLocalizer L

@{
    string T(string key, string fallback = "") {
        var v = L.GetStringValue(key);
        return string.IsNullOrWhiteSpace(v) || string.Equals(v, key, StringComparison.OrdinalIgnoreCase) ? (string.IsNullOrWhiteSpace(fallback) ? key : fallback) : v;
    }
    ViewData["Title"] = T("BackOffice.Reviewers.CreatePageTitle", "Reviewers Oluştur");
    string? currentCulture = Context.Request.RouteValues["culture"]?.ToString();
}

<div class="dashboard-main-body">
    <div class="card border shadow-none radius-12">
        <div class="card-header border-bottom">
            <h6 class="text-lg mb-0">@T("BackOffice.Reviewers.CreatePageTitle", "Reviewers Oluştur")</h6>
        </div>

        <div class="card-body">
            <form asp-action="Create" asp-route-culture="@currentCulture" method="post" autocomplete="off">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row gy-4">
            <div class="col-md-6">
                <label class="form-label" asp-for="UserId"></label>
                <input class="form-control" asp-for="UserId" />
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="Status"></label>
                <input class="form-control" asp-for="Status" />
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label d-block" asp-for="IsActive"></label>
                <input type="hidden" name="IsActive" value="false" />
                <div class="form-check form-switch">
                    <input class="form-check-input" asp-for="IsActive" value="true" />
                    <label class="form-check-label" asp-for="IsActive"></label>
                </div>
                <span asp-validation-for="IsActive" class="text-danger"></span>
            </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-24">
                    <a asp-action="Index" asp-route-culture="@currentCulture" class="btn btn-outline-neutral-900 radius-8 px-20 py-11">@T("Common.Cancel", "Vazgeç")</a>
                    <button type="submit" class="btn btn-primary-600 radius-8 px-20 py-11">@T("Common.Save", "Kaydet")</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
