                                @L["BackOffice.ProgramManagement.Cancel"]
                            </button>
                            <button type="submit" class="btn btn-primary-600" id="saveSessionOfficialsButton">
                                <i class="ri-save-line me-1"></i>@L["BackOffice.ProgramManagement.SaveSessionOfficials"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <form id="programAjaxTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
</div>

