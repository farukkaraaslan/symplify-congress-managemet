@model Symplify.BackOffice.WebUI.Models.ParticipationCertificates.PublicParticipationCertificateViewModel
@{ Layout = null; }
<!doctype html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <title>@Model.Title</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/remixicon/fonts/remixicon.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body class="min-vh-100 bg-neutral-50 d-flex align-items-center justify-content-center p-24">
<main class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-7">
            <section class="card border-0 radius-16 shadow-sm p-32">
                <div class="text-center mb-24">
                    <div class="w-72-px h-72-px rounded-circle @(Model.IsValid ? "bg-success-50 text-success-600" : "bg-danger-50 text-danger-600") d-inline-flex align-items-center justify-content-center mx-auto mb-16 text-3xl">
                        <i class="@(Model.IsValid ? "ri-shield-check-line" : "ri-shield-cross-line")"></i>
                    </div>
                    <h1 class="h3 fw-bold mb-8">@Model.Title</h1>
                    <p class="text-neutral-600 mb-0">@Model.Message</p>
                </div>
                @if (Model.PublicId.HasValue)
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <tbody>
                                <tr><th class="w-25">Katılımcı</th><td>@Model.ParticipantName</td></tr>
                                <tr><th>Kongre</th><td>@Model.CongressName</td></tr>
                                <tr><th>Bildiri No</th><td>@Model.SubmissionNumber</td></tr>
                                <tr><th>Bildiri</th><td>@Model.SubmissionTitle</td></tr>
                                <tr><th>Dil</th><td>@Model.Culture</td></tr>
                                <tr><th>Oluşturulma</th><td>@Model.GeneratedAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td></tr>
                                <tr><th>Doğrulama Kodu</th><td><code>@Model.VerificationCode</code></td></tr>
                            </tbody>
                        </table>
                    </div>
                }
                <small class="d-block mt-24 text-center text-neutral-400">Symplify Katılım Belgesi Doğrulama Sistemi</small>
            </section>
        </div>
    </div>
</main>
</body>
</html>
