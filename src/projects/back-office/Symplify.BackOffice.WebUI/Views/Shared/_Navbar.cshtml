@using Symplify.BackOffice.WebUI.Localization
@inject IBackOfficeViewLocalizer L
@{
    bool suppressSidebar = ViewData["SuppressSidebar"] as bool? == true;
    bool useAuthorTemplate = ViewData["UseAuthorTemplate"] as bool? == true;
    string culture = ViewContext.RouteData.Values["culture"]?.ToString() ?? "tr-TR";
    string homeUrl = Url.Action("Index", "Home", new { culture }) ?? $"/{culture}/Home/Index";
    string submissionsUrl = Url.Action("Index", "Submissions", new { culture }) ?? $"/{culture}/submissions";

    string T(string key, string fallback)
    {
        var value = L.GetStringValue(key);
        return !string.IsNullOrWhiteSpace(value) && !string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? value
            : fallback;
    }
}
@if (useAuthorTemplate)
{
    <header class="author-topbar">
        <div class="author-topbar__inner">
            @await Component.InvokeAsync("OrganizationBrand")

            <div class="author-topbar__actions">
                <a href="@homeUrl" class="btn btn-sm btn-outline-primary-600 radius-8 d-none d-lg-inline-flex align-items-center gap-2">
                    <i class="ri-home-5-line"></i>
                    @T("BackOffice.AuthorTopbar.Home", "Panel")
                </a>
                <a href="@submissionsUrl" class="btn btn-sm btn-outline-primary-600 radius-8 d-none d-lg-inline-flex align-items-center gap-2">
                    <i class="ri-file-list-3-line"></i>
                    @T("BackOffice.AuthorTopbar.MySubmissions", "Bildirilerim")
                </a>
                <button type="button" data-theme-toggle class="author-icon-btn" aria-label='@T("BackOffice.AuthorTopbar.ThemeToggle", "Tema değiştir")'></button>
                @await Component.InvokeAsync("LanguageSwitcher", new { displayMode = "AuthorTopbar" })
                <button type="button" class="author-icon-btn" aria-label='@T("BackOffice.AuthorTopbar.Notifications", "Bildirimler")'>
                    <i class="ri-notification-3-line text-lg"></i>
                </button>
                @await Component.InvokeAsync("UserMenu", new { displayMode = "AuthorTopbar" })
            </div>
        </div>
    </header>
}
else
{
    @* OBS template: partials/navbar.html — tek satırlık, responsive header. *@
    <div class="navbar-header symplify-navbar">
        <div class="row align-items-center justify-content-between g-3 flex-nowrap">
            <div class="col-auto">
                @if (suppressSidebar)
                {
                    <a href="@homeUrl" class="d-inline-flex align-items-center">
                        <img src="/assets/images/logo/symplify-logo-horizontal-light.svg" alt="Symplify" class="h-40-px light-logo" />
                        <img src="/assets/images/logo/symplify-logo-horizontal-dark.svg" alt="Symplify" class="h-40-px dark-logo" />
                    </a>
                }
                else
                {
                    <div class="d-flex align-items-center gap-3">
                        <button type="button" class="sidebar-toggle" aria-label='@T("BackOffice.Navbar.ToggleSidebar", "Menüyü daralt")'>
                            <iconify-icon icon="heroicons:bars-3-solid" class="icon text-2xl non-active"></iconify-icon>
                            <iconify-icon icon="iconoir:arrow-right" class="icon text-2xl active"></iconify-icon>
                        </button>
                        <button type="button" class="sidebar-mobile-toggle" aria-label='@T("BackOffice.Navbar.OpenMobileMenu", "Mobil menüyü aç")'>
                            <iconify-icon icon="heroicons:bars-3-solid" class="icon"></iconify-icon>
                        </button>
                    </div>
                }
            </div>

            <div class="col-auto ms-auto">
                <div class="d-flex flex-nowrap align-items-center justify-content-end gap-2">
                    <div class="dropdown">
                        <button type="button" class="has-indicator w-40-px h-40-px bg-neutral-100 rounded-circle d-flex align-items-center justify-content-center border-0"
                                data-bs-toggle="dropdown" aria-expanded="false"
                                aria-label='@T("BackOffice.AuthorTopbar.Notifications", "Bildirimler")'>
                            <iconify-icon icon="iconoir:bell" class="text-primary-light text-xl"></iconify-icon>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-lg p-0">
                            <div class="m-16 py-12 px-16 radius-8 bg-primary-50 d-flex align-items-center justify-content-between gap-2">
                                <div>
                                    <h6 class="text-md fw-semibold mb-1">@T("BackOffice.AuthorTopbar.Notifications", "Bildirimler")</h6>
                                    <span class="text-xs text-secondary-light">@T("BackOffice.Navbar.NotificationsDescription", "Sistem bildirimleri")</span>
                                </div>
                            </div>
                            <div class="px-24 py-24 text-center text-secondary-light">
                                @T("BackOffice.Navbar.NoNotifications", "Şu anda yeni bildiriminiz yok.")
                            </div>
                        </div>
                    </div>

                    <button type="button" data-theme-toggle
                            class="w-40-px h-40-px bg-neutral-100 rounded-circle d-flex align-items-center justify-content-center border-0"
                            aria-label='@T("BackOffice.AuthorTopbar.ThemeToggle", "Tema değiştir")'>
                        <iconify-icon icon="solar:sun-2-outline" class="text-primary-light text-xl"></iconify-icon>
                    </button>

                    @if (!suppressSidebar)
                    {
                        <button type="button" data-obs-appearance-open aria-controls="obsAppearancePanel" aria-expanded="false"
                                class="w-40-px h-40-px bg-neutral-100 rounded-circle d-none d-md-flex align-items-center justify-content-center border-0"
                                title="Tema ayarları" aria-label="Tema ayarları">
                            <i class="ri-settings-3-line text-primary-light text-xl"></i>
                        </button>
                    }

                    <div class="d-none d-sm-flex align-items-center">
                        @await Component.InvokeAsync("LanguageSwitcher")
                    </div>
                    <div class="d-flex align-items-center flex-shrink-0">
                        @await Component.InvokeAsync("UserMenu")
                    </div>
                </div>
            </div>
        </div>
    </div>
}
