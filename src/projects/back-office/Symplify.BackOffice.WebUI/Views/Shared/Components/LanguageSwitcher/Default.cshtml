@using Symplify.BackOffice.WebUI.Localization
@inject IBackOfficeViewLocalizer L
@model Symplify.BackOffice.WebUI.Models.LanguageSwitcher.LanguageSwitcherViewModel

@{
    bool useAuthorTemplate = string.Equals(ViewData["DisplayMode"]?.ToString(), "AuthorTopbar", StringComparison.OrdinalIgnoreCase);
    string currentLanguageName = Model.CurrentLanguage?.Name ?? Model.CurrentCulture;
    string currentFlag = Model.CurrentLanguage?.FlagIconPath ?? "/assets/images/flags/tr.svg";
    string buttonClass = useAuthorTemplate
        ? "author-icon-btn language-btn"
        : "navbar-action-btn has-indicator w-40-px h-40-px bg-neutral-200 rounded-circle d-flex justify-content-center align-items-center";
    string imageClass = useAuthorTemplate
        ? "w-24-px h-24-px rounded-circle"
        : "w-24-px h-24-px object-fit-cover rounded-circle";

    string T(string key, string fallback)
    {
        var value = L.GetStringValue(key);
        return !string.IsNullOrWhiteSpace(value) && !string.Equals(value, key, StringComparison.OrdinalIgnoreCase)
            ? value
            : fallback;
    }
}

<div class="dropdown d-none d-sm-inline-block">
    <button class="@buttonClass"
            type="button"
            data-bs-toggle="dropdown"
            aria-label="@currentLanguageName">
        <img src="@currentFlag" alt="@currentLanguageName" class="@imageClass" />
    </button>

    <div class="dropdown-menu dropdown-menu-sm dropdown-menu-end">
        <div class="py-12 px-16 radius-8 bg-primary-50 mb-16 d-flex align-items-center justify-content-between gap-2">
            <div>
                <h6 class="text-lg text-primary-light fw-semibold mb-0">@T("BackOffice.LanguageSwitcher.Title", "Dil Seçimi")</h6>
                <small class="text-secondary-light">@T("BackOffice.LanguageSwitcher.Description", "Varsayılan dil listenin en başında gösterilir.")</small>
            </div>
        </div>

        <div class="max-h-400-px overflow-y-auto scroll-sm pe-8">
            @foreach (var language in Model.Languages)
            {
                <a class="dropdown-item text-black px-0 py-8 hover-bg-transparent hover-text-primary d-flex align-items-center justify-content-between gap-3 @(language.IsCurrent ? "active" : string.Empty)"
                   href="@language.Url">
                    <span class="d-flex align-items-center gap-3">
                        <img src="@language.FlagIconPath"
                             alt="@language.Name"
                             class="w-36-px h-36-px bg-success-subtle text-success-main rounded-circle flex-shrink-0 object-fit-cover" />
                        <span class="d-flex flex-column">
                            <span class="text-md fw-semibold mb-0">@language.Name</span>
                            @if (language.IsDefault)
                            {
                                <small class="text-primary-600">@T("BackOffice.LanguageSwitcher.Default", "Varsayılan")</small>
                            }
                        </span>
                    </span>

                    @if (language.IsCurrent)
                    {
                        <i class="ri-check-line text-primary-600"></i>
                    }
                </a>
            }
        </div>
    </div>
</div>
