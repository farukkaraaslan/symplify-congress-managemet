{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "CacheSettings": {
    "SlidingExpiration": 2
  },
  "DatabaseInitialization": {
    "ApplyMigrations": false,
    "RunSeed": false,
    "RunCoreSeed": false,
    "RunDemoSeed": false,
    "RunCongressWorkflowBackfill": false,
    "UseEnsureCreatedWhenNoMigrations": false
  },
  "LocalizationSeed": {
    "Enabled": false,
    "OverwriteExistingTranslations": false,
    "ValidateAfterSeed": false,
    "FailOnMissingTranslation": false
  },
  "Authentication": {
    "Cookie": {
      "Name": ".Symplify.BackOffice.Auth",
      "LoginPath": "/tr-TR/auth/login",
      "AccessDeniedPath": "/tr-TR/auth/access-denied",
      "ExpireMinutes": 30,
      "SlidingExpiration": true
    },
    "DefaultSuperAdmin": {
      "Email": "",
      "Password": "",
      "Name": "",
      "Surname": "",
      "Role": ""
    },
    "Tokens": {
      "LifespanHours": 2
    }
  },
  "ObjectStorage": {
    "Provider": "",
    "Endpoint": "",
    "UseSsl": false,
    "AccessKey": "",
    "SecretKey": "",
    "Region": "",
    "Buckets": {
      "CongressDocuments": "",
      "CongressImages": "",
      "Submissions": ""
    }
  },
  "Mail": {
    "Provider": "Smtp",
    "FallbackLogoPath": "/assets/images/logo/symplify-logo-horizontal-light.svg",
    "CredentialProtection": {
      "Key": ""
    },
    "SesTracking": {
      "Enabled": false,
      "ConfigurationSetName": "",
      "AllowedTopicArns": [],
      "VerifySnsSignature": true,
      "AutoConfirmSubscription": true
    },
    "Outbox": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "BatchSize": 10,
      "MaxAttemptCount": 5
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
