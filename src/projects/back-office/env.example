# ------------------------------------------------------------
# Symplify BackOffice - Production environment template
# Copy this file to .env on the production server.
# NEVER commit the real .env file.
# ------------------------------------------------------------

ASPNETCORE_ENVIRONMENT=Production
PUBLIC_ASSET_BASE_URL=https://example.com
ALLOWED_HOSTS=example.com

# Database
DB_CONNECTION_STRING=

# Authentication / seed (only needed if your deployment uses them)
DEFAULT_SUPER_ADMIN_EMAIL=
DEFAULT_SUPER_ADMIN_PASSWORD=
DEFAULT_SUPER_ADMIN_NAME=
DEFAULT_SUPER_ADMIN_SURNAME=
DEFAULT_SUPER_ADMIN_ROLE=

# Object storage
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_USE_SSL=true
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_CONGRESS_DOCUMENTS_BUCKET=
OBJECT_STORAGE_CONGRESS_IMAGES_BUCKET=
OBJECT_STORAGE_SUBMISSIONS_BUCKET=

# Mail credential encryption key
# If an old key has encrypted DB values, do not rotate it without a re-encryption plan.
MAIL_CREDENTIAL_PROTECTION_KEY=

# Mail outbox
MAIL_OUTBOX_ENABLED=true
MAIL_OUTBOX_INTERVAL_SECONDS=30
MAIL_OUTBOX_BATCH_SIZE=10
MAIL_OUTBOX_MAX_ATTEMPT_COUNT=5

# Amazon SES tracking
MAIL_SES_TRACKING_ENABLED=true
MAIL_SES_CONFIGURATION_SET_NAME=my-first-configuration-set
MAIL_SES_ALLOWED_TOPIC_ARN=arn:aws:sns:eu-central-1:AWS_ACCOUNT_ID:symplify-ses-mail-events
MAIL_SES_VERIFY_SNS_SIGNATURE=true
MAIL_SES_AUTO_CONFIRM_SUBSCRIPTION=true
