# ============================================================
# Symplify Portal - Production Environment Example
# Copy as .env on the production server.
# DO NOT commit the real .env file.
# ============================================================

ASPNETCORE_ENVIRONMENT=Production

# Public API
PORTAL_PUBLIC_API_BASE_URL=https://api.example.com
PORTAL_PUBLIC_API_KEY=CHANGE_ME
PORTAL_PUBLIC_API_PUBLIC_HOST=example.com
PORTAL_PUBLIC_API_DEFAULT_CULTURE=tr-TR
PORTAL_PUBLIC_API_TIMEOUT_SECONDS=30
PORTAL_PUBLIC_API_SHELL_CACHE_SECONDS=120

# BackOffice / Portal
PORTAL_BACKOFFICE_BASE_URL=https://admin.example.com
PORTAL_BACKOFFICE_LOGIN_PATH_TEMPLATE=/{culture}/auth/login
PORTAL_DEFAULT_ORGANIZATION_CODE=CHANGE_ME
